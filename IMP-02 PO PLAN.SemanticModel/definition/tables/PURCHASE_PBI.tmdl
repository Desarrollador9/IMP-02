	column OC_Link = ```
			
			VAR BaseURL =
			    "https://parnersenseitcs-my.sharepoint.com/shared?id="
			
			VAR FolderPath =
			    "%2Fsites%2FCentrodeDocumentacinGrupoInteca%2FDocumentos%20compartidos%2FCentro%20de%20Documentaci%C3%B3n%20Grupo%20Inteca%20Digitalizado%2FProveedores%2FTransacciones%20con%20proveedores%20internacionales%2FOC%C2%B4s%2F"
			
			VAR OC_Number =
			    SUBSTITUTE(PURCHASE_PBI[PURCHID], "_", "-")
			
			VAR OC_Cleaned =
			    IF(LEFT(OC_Number, 3) = "OC-", OC_Number, "OC-" & OC_Number)
			
			VAR ProveedorCompleto =
			    RELATED(VENDOR_NAME[ACCOUNTNUM])
			
			VAR ListURL =
			    "&listurl=https%3A%2F%2Fparnersenseitcs%2Esharepoint%2Ecom%2Fsites%2FCentrodeDocumentacinGrupoInteca%2FDocumentos%20compartidos"
			
			VAR UrlOC =
			    BaseURL
			        & FolderPath
			        & "cmer-" & OC_Cleaned & "-" & ProveedorCompleto
			        & ListURL
			
			RETURN
			    UrlOC
			
			```
		lineageTag: da8bb31e-0a67-48f7-86d3-cd69c78cea96
		dataCategory: WebUrl
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isText":true}

	column BL_Link = ```
			
			VAR Existe_Carpeta = LOOKUPVALUE(Carpetas_Existentes[BL_EXISTENTE], Carpetas_Existentes[PURCHID], PURCHASE_PBI[PURCHID])
			
			VAR BaseURL = "https://parnersenseitcs.sharepoint.com/:b:/r/sites/CentrodeDocumentacinGrupoInteca/"
			
			VAR FolderPath = "Documentos%20compartidos/Centro%20de%20Documentaci%C3%B3n%20Grupo%20Inteca%20Digitalizado/Proveedores/Transacciones%20con%20proveedores%20internacionales/OC%C2%B4s/"
			
			VAR OC_Number = SUBSTITUTE(PURCHASE_PBI[PURCHID], "_", "-") 
			VAR OC_Cleaned = IF(LEFT(OC_Number, 3) = "OC-", OC_Number, "OC-" & OC_Number)
			
			VAR ProveedorCompleto = RELATED(VENDOR_NAME[ACCOUNTNUM]) 
			VAR PosGuion = FIND("-", ProveedorCompleto, 1, LEN(ProveedorCompleto)) 
			VAR Proveedor = IF(PosGuion > 0, LEFT(ProveedorCompleto, PosGuion - 1), ProveedorCompleto) 
			VAR Proveedor_Codificado = SUBSTITUTE(Proveedor, "-", "%2D")
			
			VAR Subfolder = "DOCUMENTACI%C3%93N"
			
			-- 🔹 Extrae correctamente el número de PURCHID sin errores
			VAR BL_Number = SUBSTITUTE(OC_Cleaned, "OC-00", "")
			
			-- 🔹 Nombre del archivo asegurando que el espacio entre "BL" y el número esté bien codificado
			VAR BL_Document = "BL%20" & BL_Number & ".pdf"
			
			-- 🔹 Parámetros adicionales de SharePoint
			VAR SharePoint_Params = "?csf=1&web=1"
			
			-- 🔹 URL final replicando el formato exacto que SharePoint genera
			VAR FileURL = BaseURL & FolderPath & "cmer-" & OC_Cleaned & "-" & ProveedorCompleto & "/" & Subfolder & "/" & BL_Document & SharePoint_Params
			
			RETURN 
			IF(
			    Existe_Carpeta = "Sí",  
			    FileURL,  -- Muestra el enlace directo al archivo
			    BL_Number  -- Si no existe, solo muestra el número sin enlace
			)
			
			```
		lineageTag: ab32d1ec-94cb-4f1c-af05-62364ad67e6f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column EURO_PO_Link = ```
			
			VAR Existe_Carpeta = LOOKUPVALUE(Carpetas_Existentes[EURO_PO_EXISTENTE], Carpetas_Existentes[PURCHID], PURCHASE_PBI[PURCHID])
			
			VAR BaseURL = "https://parnersenseitcs.sharepoint.com/:b:/r/sites/CentrodeDocumentacinGrupoInteca/"
			
			VAR FolderPath = "Documentos%20compartidos/Centro%20de%20Documentaci%C3%B3n%20Grupo%20Inteca%20Digitalizado/Proveedores/Transacciones%20con%20proveedores%20internacionales/OC%C2%B4s/"
			
			VAR OC_Number = SUBSTITUTE(PURCHASE_PBI[PURCHID], "_", "-") 
			VAR OC_Cleaned = IF(LEFT(OC_Number, 3) = "OC-", OC_Number, "OC-" & OC_Number)
			
			VAR ProveedorCompleto = RELATED(VENDOR_NAME[ACCOUNTNUM]) 
			VAR PosGuion = FIND("-", ProveedorCompleto, 1, LEN(ProveedorCompleto)) 
			VAR Proveedor = IF(PosGuion > 0, LEFT(ProveedorCompleto, PosGuion - 1), ProveedorCompleto) 
			VAR Proveedor_Codificado = SUBSTITUTE(Proveedor, "-", "%2D")
			
			VAR Subfolder = "DOCUMENTACI%C3%93N"
			
			-- 🔹 Extrae correctamente el número de PURCHID sin errores
			VAR PO_Number = SUBSTITUTE(OC_Cleaned, "OC-00", "")
			
			-- 🔹 Nombre del archivo asegurando que el espacio entre "EURO 1 PO" y el número esté bien codificado
			VAR PO_Document = "EURO%201%20PO%20" & PO_Number & ".pdf"
			
			-- 🔹 Parámetros adicionales de SharePoint
			VAR SharePoint_Params = "?csf=1&web=1"
			
			-- 🔹 URL final replicando el formato exacto que SharePoint genera
			VAR FileURL = BaseURL & FolderPath & "cmer-" & OC_Cleaned & "-" & ProveedorCompleto & "/" & Subfolder & "/" & PO_Document & SharePoint_Params
			
			RETURN 
			IF(
			    Existe_Carpeta = "Sí",  
			    FileURL,  -- Muestra el enlace directo al archivo
			    PO_Number  -- Si no existe, solo muestra el número sin enlace
			)
			```
		lineageTag: d91b5b1a-9b15-4afa-bbe3-d93324ff136c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column TIRS_Link1 = ```
			
			VAR BaseURL = "https://parnersenseitcs-my.sharepoint.com/shared?id="
			VAR FolderPath = "%2Fsites%2FCentrodeDocumentacinGrupoInteca%2FDocumentos%20compartidos%2FCentro%20de%20Documentaci%C3%B3n%20Grupo%20Inteca%20Digitalizado%2FProveedores%2FTransacciones%20con%20proveedores%20internacionales%2FOC%C2%B4s%2F"
			
