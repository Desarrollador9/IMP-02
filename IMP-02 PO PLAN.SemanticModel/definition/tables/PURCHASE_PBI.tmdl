	measure Est_T0 = SUMX('CUBO INVENTARIOS', ((('CUBO INVENTARIOS'[[Measures]].[Rot Diaria Total]]] / 'CUBO INVENTARIOS'[[Measures]].[Und X Cajas]]]) * 7 )) * 'CUBO INVENTARIOS'[CRECIMIENTO.GROWTH])
		lineageTag: c3046805-6b6b-4599-af38-edff46ffad9d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Entradas_Tarima = ```
			
			SUMX(
			    PURCHASE_PBI,
			    VAR ItemActual = PURCHASE_PBI[ITEMID] 
			    VAR Factor = CALCULATE(
			        MAX(UNIDADES_TARIMAS[FACTOR]),
			        UNIDADES_TARIMAS[ITEMID] = ItemActual
			    )
			    RETURN
			    DIVIDE(PURCHASE_PBI[Dif_Recib], Factor, 0)
			)
			```
		formatString: 0
		lineageTag: b4c93202-58ad-4a08-aeaa-57ee4e92d134

		annotation PBI_FormatHint = {"isDecimal":true}

	measure Dif_Recib = SUM(PURCHASE_PBI[CANTIDAD]) - SUM(RECEPCIONES[CANT_RECIBIDO])
		formatString: 0
		lineageTag: 014e342c-20c9-4a79-a359-b4dc3d379a9a

		annotation PBI_FormatHint = {"isDecimal":true}

	measure Cant_desi_Contenedores = ```
			
			IF(  
			    HASONEFILTER(PURCHASE_PBI[PURCHID]),  
			    VAR Cant = [Cant_cont]  
			    RETURN   
			        IF(  
			            ROUND(Cant, 2) = INT(Cant),  
			            INT(Cant),  
			            FORMAT(Cant, "0.00")  
			        ),  
			    VAR TotalContenedores = SUMX(VALUES(PURCHASE_PBI[PURCHID]), [Cant_cont])  
			    RETURN  
			        IF(  
			            ROUND(TotalContenedores, 2) = INT(TotalContenedores),  
			            INT(TotalContenedores),  
			            FORMAT(TotalContenedores, "0.00")  
			        )  
			)
			```
		formatString: 0
		lineageTag: 7513c594-fa98-4fc6-aa7f-107a28ed2bc7

		annotation PBI_FormatHint = {"isDecimal":true}

	measure Costo_Total_Unitario = ```
			
			    SUMX(
			        'CUBO INVENTARIOS',
			        'CUBO INVENTARIOS'[[Measures]].[Und X Cajas]]]* 'CUBO INVENTARIOS'[[Measures]].[Costo Unitario]]]*[Invent_Actual]
			    )
			
			```
		lineageTag: 38ca853e-4777-46a4-94cc-d6ffb14c172e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Costo_Total_OC = ```
			
			    SUMX(
			        'CUBO INVENTARIOS',
			        'CUBO INVENTARIOS'[[Measures]].[Und X Cajas]]]* 'CUBO INVENTARIOS'[[Measures]].[Costo Unitario]]]*SUM(PURCHASE_PBI[CANTIDAD])
			    )
			
			```
		lineageTag: 5468d033-fd99-4ce4-b65a-1fb433c5ea86

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TotalOCConTotales = ```
			
			IF(
			    ISINSCOPE(PURCHASE_PBI[PURCHID]), 
			    SELECTEDVALUE(PURCHASE_PBI[PURCHID]),  -- Muestra los valores de la columna en filas
