	column 'Tipo Concat' =
			
			VAR Tipo = CATALOGO_PBI_INVENTARIO[TIPO]
			VAR NombreTipo = CATALOGO_PBI_INVENTARIO[NOMBRE_TIPO]
			RETURN
			    IF(
			        NOT(ISBLANK(Tipo)) && Tipo <> "",
			        "(" & Tipo & ") " & NombreTipo,
			        ""
			    )
		lineageTag: aafbe25b-75ff-4475-bf70-43aaaa46c16c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

