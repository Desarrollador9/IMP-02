table VENDTRANS
	lineageTag: 919ce659-d4c4-43ce-adc7-9dfffa2d3b57

	/// Saldo pendiente por OC usando TREATAS para cruzar VENDTRANS con PURCHASE_PBI sin relacion fisica. Funciona aunque PURCHASE_PBI tenga PURCHID duplicado.
	measure Saldo_por_OC =
			VAR ocs_en_contexto = VALUES( PURCHASE_PBI[PURCHID] )
			VAR saldo =
			    CALCULATE(
			        SUMX(
			            VENDTRANS,
			            VENDTRANS[amountcur] - VENDTRANS[settleamountcur]
			        ),
			        TREATAS( ocs_en_contexto, VENDTRANS[OC_Extraida] )
			    )
			RETURN
			    IF( ISBLANK( saldo ), BLANK(), saldo )
		formatString: #,0.00
		displayFolder: Saldos
		lineageTag: 45e4c475-1ac9-49dc-a544-ddf64279115f

	/// Saldo por OC formateado como texto con moneda. Para usar en tarjeta o tabla auxiliar junto a la matriz.
	measure Saldo_txt =
			VAR saldo_num =
			    CALCULATE(
			        SUMX(
			            VENDTRANS,
			            VENDTRANS[amountcur] - VENDTRANS[settleamountcur]
			        ),
			        TREATAS( VALUES( PURCHASE_PBI[PURCHID] ), VENDTRANS[OC_Extraida] )
			    )
			RETURN
			    IF(
			        ISBLANK( saldo_num ),
			        BLANK(),
			        FORMAT( saldo_num, "#,##0.00" )
			    )
		formatString: @
		displayFolder: Saldos
		lineageTag: ef0b7257-d6f7-4577-b119-3c2f8814ce13

