	measure Prom_3S = ```
			
			VAR Hoy = TODAY()
			VAR FinUltSemanaCompleta = Hoy - WEEKDAY(Hoy, 1)
			VAR Inicio3Semanas = FinUltSemanaCompleta - 20
			RETURN
			DIVIDE(
			    CALCULATE(
			        SUMX(
			            Sales, 
			            IF(
			                ISNUMBER(Sales[Fact]) && Sales[Fact] <> 0, 
			                DIVIDE(Sales[CANTIDAD], Sales[Fact], 0), 
			                0
			            )
			        ),
			        FILTER(
			            ALL(Sales[INVOICEDATE]),
			            Sales[INVOICEDATE] >= Inicio3Semanas
			                && Sales[INVOICEDATE] <= FinUltSemanaCompleta
			        )
			    ),
			    3
			)
			```
		formatString: 0
		lineageTag: 4b131d2d-13a2-45d6-9b81-f53b4e2a4c08

	measure Prom_3M = ```
			
			VAR Hoy = TODAY()
			VAR FinUltSemanaCompleta = Hoy - WEEKDAY(Hoy, 1)
			VAR Inicio13Semanas = FinUltSemanaCompleta - 90
			RETURN
			DIVIDE(
			    CALCULATE(
			        SUMX(
			            Sales, 
			            IF(
			                ISNUMBER(Sales[Fact]) && Sales[Fact] <> 0, 
			                DIVIDE(Sales[CANTIDAD], Sales[Fact], 0), 
			                0
			            )
			        ),
			        FILTER(
			            ALL(Sales[INVOICEDATE]),
			            Sales[INVOICEDATE] >= Inicio13Semanas
			                && Sales[INVOICEDATE] <= FinUltSemanaCompleta
			        )
			    ),
			    13
			)
			```
		formatString: 0
		lineageTag: 0ce0404b-d494-44f0-bacb-14e05e70e5c7

		annotation PBI_FormatHint = {"isDecimal":true}

	measure Prom_3S_Valor =
			
			VAR Hoy = TODAY()
			VAR FinUltSemanaCompleta = Hoy - WEEKDAY(Hoy, 1)
			VAR Inicio3Semanas = FinUltSemanaCompleta - 20
			RETURN
			DIVIDE(
			    CALCULATE(
			        SUMX(Sales, Sales[MONTO_VENTA] / 1000000),
			        FILTER(
			            ALL(Sales[INVOICEDATE]),
			            Sales[INVOICEDATE] >= Inicio3Semanas
			                && Sales[INVOICEDATE] <= FinUltSemanaCompleta
			        )
			    ),
			    3
			)
		formatString: 0.0
		lineageTag: c187475e-3417-4a03-a567-d6ca35217447

	measure Prom_3M_Valor =
			
			VAR Hoy = TODAY()
			VAR FinUltSemanaCompleta = Hoy - WEEKDAY(Hoy, 1)
			VAR Inicio13Semanas = FinUltSemanaCompleta - 90
			RETURN
			DIVIDE(
			    CALCULATE(
			        SUMX(Sales, Sales[MONTO_VENTA] / 1000000),
			        FILTER(
			            ALL(Sales[INVOICEDATE]),
			            Sales[INVOICEDATE] >= Inicio13Semanas
			                && Sales[INVOICEDATE] <= FinUltSemanaCompleta
			        )
			    ),
			    13
			)
		formatString: 0.0
		lineageTag: 8a62019d-c1d9-4580-a312-7cf44c9e9e61

	measure MedidasAgrupadasCalculadas = ```
			
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE(Grupos2[Medida]) = "5)VT-1", [QTY],
			    SELECTEDVALUE(Grupos2[Medida]) = "2)3S", [Prom_3S],
			    SELECTEDVALUE(Grupos2[Medida]) = "1)3M", [Prom_3M],
			    SELECTEDVALUE(Grupos2[Medida]) = "3)Est Meta Base", [Est_Base],
			    SELECTEDVALUE(Grupos2[Medida]) = "4)Est T0", [Est_T0],
			    SELECTEDVALUE(Grupos2[Medida]) = "5)VT-1.", [VALOR],
			    SELECTEDVALUE(Grupos2[Medida]) = "2)3S.", [Prom_3S_Valor],
			    SELECTEDVALUE(Grupos2[Medida]) = "1)3M.", [Prom_3M_Valor],
			    SELECTEDVALUE(Grupos2[Medida]) = "3)Est Meta Base.", [Valor_Estimada],
			    SELECTEDVALUE(Grupos2[Medida]) = "4)Est T0.", [Valor_Estimada_T0], 
			    SELECTEDVALUE(Grupos2[Medida]) = "6)%Val/Est Base", [NewVal],
			     SELECTEDVALUE(Grupos2[Medida]) = "CB T-1", [CB],
			  
			      
			   
			    BLANK()
			)
			
			
			```
		lineageTag: 33989370-3d80-4658-87d8-96987e05d82d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

