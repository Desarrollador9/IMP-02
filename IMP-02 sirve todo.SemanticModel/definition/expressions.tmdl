expression 'Inventory value cube' =
		let
		    Source = AnalysisServices.Databases("SJOCUBES", [TypedMeasureColumns=true, Implementation="2.0"]),
		    #"Dynamics AX" = Source{[Name="Dynamics AX"]}[Data],
		    #"Inventory value cube1" = #"Dynamics AX"{[Id="Inventory value cube"]}[Data],
		    #"Inventory value cube2" = #"Inventory value cube1"{[Id="Inventory value cube"]}[Data],
		    #"Added Items" = Cube.Transform(#"Inventory value cube2",
		        {
		            {Cube.AddAndExpandDimensionColumn, "[Company]", {"[Company].[Company].[Company]"}, {"Company.Company"}},
		            {Cube.AddAndExpandDimensionColumn, "[Released products]", {"[Released products].[Articulo].[Articulo]"}, {"Released products.Articulo"}},
		            {Cube.AddMeasureColumn, "Rotacion Estimada", "[Measures].[Rotacion Estimada]"},
		            {Cube.AddMeasureColumn, "Und X Cajas", "[Measures].[Und X Cajas]"},
		            {Cube.AddMeasureColumn, "Cajas T+1", "[Measures].[Cajas T+1]"},
		            {Cube.AddMeasureColumn, "Cajas T+2", "[Measures].[Cajas T+2]"},
		            {Cube.AddMeasureColumn, "Cajas T+3", "[Measures].[Cajas T+3]"},
		            {Cube.AddMeasureColumn, "Cajas T+4", "[Measures].[Cajas T+4]"}
		        }),
		    #"Filtered Rows" = Table.SelectRows(#"Added Items", each [Company.Company] = "CMER"),
		    #"Added Items1" = Cube.Transform(#"Filtered Rows",
		        {
		            {Cube.AddMeasureColumn, "Cajas T+10", "[Measures].[Cajas T+10]"},
		            {Cube.AddMeasureColumn, "Cajas T+4.1", "[Measures].[Cajas T+4]"},
		            {Cube.AddMeasureColumn, "Cajas T+5", "[Measures].[Cajas T+5]"},
		            {Cube.AddMeasureColumn, "Cajas T+6", "[Measures].[Cajas T+6]"},
		            {Cube.AddMeasureColumn, "Cajas T+7", "[Measures].[Cajas T+7]"},
		            {Cube.AddMeasureColumn, "Cajas T+8", "[Measures].[Cajas T+8]"},
		            {Cube.AddMeasureColumn, "Cajas T+9", "[Measures].[Cajas T+9]"},
		            {Cube.AddMeasureColumn, "Cajas T+11", "[Measures].[Cajas T+11]"},
		            {Cube.AddMeasureColumn, "Cajas T+12", "[Measures].[Cajas T+12]"},
		            {Cube.AddMeasureColumn, "Cajas T+13", "[Measures].[Cajas T+13]"},
		            {Cube.AddMeasureColumn, "Cajas T+14", "[Measures].[Cajas T+14]"},
		            {Cube.AddMeasureColumn, "Cajas T+15", "[Measures].[Cajas T+15]"},
		            {Cube.AddMeasureColumn, "Cajas T+16", "[Measures].[Cajas T+16]"},
		            {Cube.AddMeasureColumn, "Cajas T+17", "[Measures].[Cajas T+17]"},
		            {Cube.AddMeasureColumn, "Cajas T+18", "[Measures].[Cajas T+18]"}
		        }),
		    #"Removed Columns" = Table.RemoveColumns(#"Added Items1",{"Cajas T+4.1"})
		in
		    #"Removed Columns"
	lineageTag: 12838718-4a51-4e32-b0d9-1dff8f80e84f

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

