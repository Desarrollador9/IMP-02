	partition PURCHASE_PBI = m
		mode: import
		source = ```
				let
				    Source = Sql.Database("SJODB003", "GIAX2012_PROD", [MultiSubnetFailover=true]),
				    dbo_PURCHASE_PBI = Source{[Schema="dbo",Item="PURCHASE_PBI"]}[Data],
				    #"Added Custom" = Table.AddColumn(dbo_PURCHASE_PBI, "Artículo", each "("&[ITEMID]&")"&" "&[PRODUCTNAME]),
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "KEY", each [DATAAREAID]&[ORDERACCOUNT]),
				    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "KEY_GEN", each [DATAAREAID]&[ITEMID]),
				    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "KEY_1", each [DATAAREAID] & Text.From([NUMERO_CONTRATO])),
				    #"Personalizada agregada" = Table.AddColumn(#"Added Custom3", "KEY_RECEP", each [PURCHID] & [UNIDAD] & [ITEMID]),
				    #"Columna duplicada" = Table.DuplicateColumn(#"Personalizada agregada", "PURCHID", "PURCHID - Copia"),
				    #"Valor reemplazado" = Table.ReplaceValue(#"Columna duplicada","OC-00","",Replacer.ReplaceText,{"PURCHID - Copia"}),
				    #"Valor reemplazado1" = Table.ReplaceValue(#"Valor reemplazado","OC_00","",Replacer.ReplaceText,{"PURCHID - Copia"}),
				    #"Added Custom4" = Table.AddColumn(#"Valor reemplazado1", "Vencimiento Días Libres", each if [LLEGADA_PAIS] = null or [DIAS_LIBRES] = null then null else Date.AddDays([LLEGADA_PAIS], [DIAS_LIBRES])),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Custom4",{{"Vencimiento Días Libres", type date}}),
				    #"Added Index" = Table.AddIndexColumn(#"Changed Type", "Index", 1, 1, Int64.Type),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Added Index",{{"LLEGADA_DOC_ORIGEN", type date}}),
				    #"Added Custom5" = Table.AddColumn(#"Changed Type1", "Sem Salida Ajustada", each let
				        semanaActual = Date.WeekOfYear(DateTime.LocalNow()),
				        añoActual = Date.Year(DateTime.LocalNow()),
				        semanaFecha = Date.WeekOfYear([SALIDA_AJUSTADA]),
				        añoFecha = Date.Year([SALIDA_AJUSTADA]),
				        diferencia = semanaFecha - semanaActual + ((añoFecha - añoActual) * 52),
				        
				        etiqueta = if diferencia = 0 then "T (" & Text.From(semanaFecha) & ")"
				                   else if diferencia > 0 then "T+" & Text.From(diferencia) & " (" & Text.From(semanaFecha) & ")"
				                   else "T" & Text.From(diferencia) & " (" & Text.From(semanaFecha) & ")"
				    in
				        etiqueta),
				    #"Added Custom6" = Table.AddColumn(#"Added Custom5", "Sem Acept Doc", each let
				        semanaActual = Date.WeekOfYear(DateTime.LocalNow()),
				        añoActual = Date.Year(DateTime.LocalNow()),
				        semanaFecha = Date.WeekOfYear([ACEPTACION_DOC]),
				        añoFecha = Date.Year([ACEPTACION_DOC]),
				        diferencia = semanaFecha - semanaActual + ((añoFecha - añoActual) * 52),
				        
				        etiqueta = if diferencia = 0 then "T (" & Text.From(semanaFecha) & ")"
				                   else if diferencia > 0 then "T+" & Text.From(diferencia) & " (" & Text.From(semanaFecha) & ")"
				                   else "T" & Text.From(diferencia) & " (" & Text.From(semanaFecha) & ")"
				    in
				        etiqueta),
				    #"Added Custom7" = Table.AddColumn(#"Added Custom6", "Sem Vencimiento Dias", each let
				        semanaActual = Date.WeekOfYear(DateTime.LocalNow()),
				        añoActual = Date.Year(DateTime.LocalNow()),
				        semanaFecha = Date.WeekOfYear([VENCIMIENTO_DIAS_LIBRES]),
				        añoFecha = Date.Year([VENCIMIENTO_DIAS_LIBRES]),
				        diferencia = semanaFecha - semanaActual + ((añoFecha - añoActual) * 52),
				        
				        etiqueta = if diferencia = 0 then "T (" & Text.From(semanaFecha) & ")"
				                   else if diferencia > 0 then "T+" & Text.From(diferencia) & " (" & Text.From(semanaFecha) & ")"
				                   else "T" & Text.From(diferencia) & " (" & Text.From(semanaFecha) & ")"
				    in
				        etiqueta),
				    #"Added Custom8" = Table.AddColumn(#"Added Custom7", "Sem Devolución Contenedor", each let
				        semanaActual = Date.WeekOfYear(DateTime.LocalNow()),
				        añoActual = Date.Year(DateTime.LocalNow()),
				        semanaFecha = Date.WeekOfYear([FECHA_DEVOLUCION_CONTENEDOR]),
				        añoFecha = Date.Year([FECHA_DEVOLUCION_CONTENEDOR]),
				        diferencia = semanaFecha - semanaActual + ((añoFecha - añoActual) * 52),
				        
				        etiqueta = if diferencia = 0 then "T (" & Text.From(semanaFecha) & ")"
				                   else if diferencia > 0 then "T+" & Text.From(diferencia) & " (" & Text.From(semanaFecha) & ")"
				                   else "T" & Text.From(diferencia) & " (" & Text.From(semanaFecha) & ")"
				    in
				        etiqueta),
				    #"Added Custom9" = Table.AddColumn(#"Added Custom8", "Sem DUA", each let
				        semanaActual = Date.WeekOfYear(DateTime.LocalNow()),
				        añoActual = Date.Year(DateTime.LocalNow()),
				        semanaFecha = Date.WeekOfYear([DATEDUA]),
				        añoFecha = Date.Year([DATEDUA]),
				        diferencia = semanaFecha - semanaActual + ((añoFecha - añoActual) * 52),
				        
				        etiqueta = if diferencia = 0 then "T (" & Text.From(semanaFecha) & ")"
				                   else if diferencia > 0 then "T+" & Text.From(diferencia) & " (" & Text.From(semanaFecha) & ")"
				                   else "T" & Text.From(diferencia) & " (" & Text.From(semanaFecha) & ")"
				    in
				        etiqueta),
				    #"Added Custom10" = Table.AddColumn(
				    #"Added Custom9",
				    "PURCHID+CONT",
				    each
				        Text.From([PURCHID]) & " - " &
				        Number.ToText(Number.Round([CANT_CONTENEDOR], 1), "0.0") & " cont.",
				    type text
				),
				    #"Personalizada agregada1" = Table.AddColumn(#"Added Custom10", "SITIO_AF_CONCAT", each 
				    if [INVENTSITEAF] <> null and [INVENTSITEAF] <> "" 
				    then "(" & [INVENTSITEAF] & ") " & [NOMBRE_SITIO_AF] 
				    else ""
				),
				    #"Personalizada agregada2" = Table.AddColumn(#"Personalizada agregada1", "SITIO_FINAL_CONCAT", each 
				    if [SITIO_DEST_FINAL] <> null and [SITIO_DEST_FINAL] <> "" 
				    then "(" & [SITIO_DEST_FINAL] & ") " & [NOMBRE_SITIO_FINAL] 
				    else ""
				)
				in
				    #"Personalizada agregada2"
				```

