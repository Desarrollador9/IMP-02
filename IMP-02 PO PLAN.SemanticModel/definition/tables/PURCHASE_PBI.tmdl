	measure 'Peso teórico' = ```
			
			SUMX(
			    VALUES( PURCHASE_PBI[PURCHID] ),
			    VAR Cant = [Cant_Contenedores]
			    VAR PesoMax =
			        CALCULATE( MAX ( 'TIPOS CONTENEDORES'[peso_maximo] ) )
			    RETURN
			        IF( Cant > 0, (Cant * PesoMax) / 1000 )
			)
			
			```
		formatString: #,0.00
		lineageTag: f096b56f-c890-41f8-b13f-d961b30ed94c

	measure '% Ocupacion Peso' = ```
			
			VAR TablaOC =
			    ADDCOLUMNS(
			        VALUES( PURCHASE_PBI[PURCHID] ),
			        "PesoReal",
			            CALCULATE( SUMX(PURCHASE_PBI, PURCHASE_PBI[Peso] * PURCHASE_PBI[CANTIDAD]) ),
			        "PesoTeorico",
			            VAR Cant = [Cant_Contenedores]
			            VAR PesoMax = CALCULATE( MAX('TIPOS CONTENEDORES'[peso_maximo]) )
			            RETURN IF( Cant > 0, Cant * PesoMax )
			    )
			RETURN
			DIVIDE(
			    SUMX( TablaOC, [PesoReal] ),
			    SUMX( TablaOC, [PesoTeorico] )
			)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0978fe0d-f98e-4daf-8dff-3ff5e8578212

