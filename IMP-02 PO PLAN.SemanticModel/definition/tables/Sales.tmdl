	measure QTY = ```
			
			SUMX(
			    SALES, 
			    IF(
			        ISNUMBER(SALES[Fact]) && SALES[Fact] <> 0, 
			        DIVIDE(SALES[CANTIDAD], SALES[Fact], 0), 
			        0
			    )
			)
			```
		formatString: #,0
		lineageTag: 6b6cbac5-6993-4b0f-bdda-46659ff594cb

		annotation PBI_FormatHint = {"isDecimal":true}

