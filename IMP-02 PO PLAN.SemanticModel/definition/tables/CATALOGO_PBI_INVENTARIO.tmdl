	partition CATALOGO_PBI_INVENTARIO = m
		mode: import
		source =
				let
				    Source = Sql.Database("SJODB002", "GIAX2012_PROD", [MultiSubnetFailover=true, Query="SELECT DISTINCT #(lf)    T1.INVENTCLASIFICACIONINVENTARIO,#(lf)    T1.ITEMID,#(lf)    T1.DATAAREAID,#(lf)    T1.PRODUCTCATEGORYID,#(lf)    T1.FAMILYID, #(lf)    T1.DATAAREAID + T1.ITEMID AS KEY_GEN,#(lf)    T1.SUBFAMILYID AS SUBFAMILIA, #(lf)    T1.PRODUCTSUBCATEGORYID AS SUBCATEGORIA,#(lf)    T1.SubSubCategoryID AS SUBSUBCATEGORIA,#(lf)    T1.ITEMMARKID,#(lf)    T1.GI_InventoryBoxNumber AS CUADRO,#(lf)    ITB.GI_INVENTORYBOXNAME AS NOMBRE_CUADRO,#(lf)    [dbo].[Get_NameEmployee](ITL.POSITIONID) AS ENCARGADO,#(lf)    T1.LIFECYCLEPRODUCTID AS CICLO_VIDA,#(lf)#(tab)LP.NAME AS NOMBRE_CICLO,#(lf)    ITM.UNITID AS UNIDAD,#(lf)    ITM1.UNITID AS UNIDAD_INVENTARIO,#(lf)    PROD.PRODUCTNAME,#(lf)    FAM.LIFECYCLEID AS CICLO_FAMILIA,#(lf)    SFAM.LIFECYCLEID AS CICLO_SUBFAMILIA,#(lf)    PC.LIFECYCLEID AS CICLO_CATEGORIA,#(lf)    PSC.LIFECYCLEID AS CICLO_SUBCATEGORIA,#(lf)    T1.INVENTITEMTYPEID AS TIPO,#(lf)#(tab)IIT.NAME AS NOMBRE_TIPO,#(lf)    T1.ITEMLINE AS COD_LINEA,#(lf)    ITL.DESCRIPTION AS DESCRIPCION_LINEA,#(lf)    T1.PRODUCTUSEID AS USO_PRODUCTO,#(lf)    [dbo].[Get_NameEmployee](COALESCE(HCM3.POSITIONID, HCM2.POSITIONID, HCM1.POSITIONID)) AS POSITION,#(lf)    [dbo].[Get_unitConversionbyParent5](T1.PRODUCT, ITM1.UNITID, 'TARIMA') AS FACTOR_TARIMA,#(lf)#(tab)[dbo].[Get_unitConversionbyParent5](T1. PRODUCT, ITM1.UNITID, 'CAJA') AS FACTOR_CAJA,#(lf)#(tab)T1.SECURITYINVENTORY AS SEGURIDAD_MIN,#(lf)#(tab)CASE ECO.PRODUCTTYPE#(lf)#(tab)#(tab)WHEN 1 THEN 'Artículo'#(lf)#(tab)#(tab)WHEN 2 THEN 'Servicio'#(lf)#(tab)#(tab)ELSE ''#(lf)#(tab)END AS TIPO2,#(lf)#(tab)T1.EstimatedRotation + T1.EstimatedKitsDailyRotL1 + T1.EstimatedKitsDailyRotL2 AS ROTACION_FUTURA,#(lf)#(tab)T1.EstimatedDailyHistoricRotation + T1.EstimatedKitsDailyHistoricRotL1 + T1.EstimatedKitsDailyHistoricRotL2 AS ROTACION_3M,#(lf)#(tab)T1.EstimatedDailyHistoric3SRotation + T1.EstimatedKitsDailyHistoric3SRotL1 + EstimatedKitsDailyHistoric3SRotL2 AS ROTACION_3S,#(lf)#(tab)IIF(T1.INDBLOQUEADOPDA = 1, 'Sí', 'No') AS BLOQ_PS,#(lf)    GETDATE() AS UPDATES#(lf)FROM INVENTTABLE T1#(lf)    LEFT OUTER JOIN INVENTORYBOX ITB #(lf)        ON ITB.GI_INVENTORYBOXNUMBER = T1.GI_InventoryBoxNumber #(lf)       AND ITB.DATAAREAID = T1.DATAAREAID#(lf)    LEFT OUTER JOIN INVENTITEMLINE AS ITL #(lf)        ON ITL.LINECODE = T1.ITEMLINE #(lf)       AND ITL.PARTITION = T1.PARTITION#(lf)    LEFT OUTER JOIN INVENTTABLEMODULE ITM #(lf)        ON T1.ITEMID = ITM.ITEMID #(lf)       AND T1.DATAAREAID = ITM.DATAAREAID #(lf)       AND ITM.MODULETYPE = 1#(lf)    LEFT OUTER JOIN INVENTTABLEMODULE ITM1 #(lf)        ON T1.ITEMID = ITM1.ITEMID #(lf)       AND T1.DATAAREAID = ITM1.DATAAREAID #(lf)       AND ITM1.MODULETYPE = 0#(lf)    LEFT OUTER JOIN PRODUCT_PBI PROD #(lf)        ON PROD.DISPLAYPRODUCTNUMBER = T1.ITEMID#(lf)    LEFT OUTER JOIN FAMILY FAM #(lf)        ON FAM.FAMILYID = T1.FAMILYID#(lf)    LEFT OUTER JOIN HCMPOSITION HCM1 #(lf)        ON HCM1.RECID = FAM.INVENTORYMANAGER#(lf)    LEFT OUTER JOIN SUBFAMILY SFAM #(lf)        ON SFAM.SUBFAMILYID = T1.SUBFAMILYID #(lf)       AND SFAM.FAMILYID = T1.FAMILYID #(lf)       AND SFAM.RECID <> 5637179827#(lf)    LEFT OUTER JOIN HCMPOSITION HCM2 #(lf)        ON HCM2.RECID = SFAM.INVENTORYMANAGER#(lf)    LEFT OUTER JOIN PRODUCTCATEGORY PC #(lf)        ON PC.PRODUCTCATEGORYID = T1.PRODUCTCATEGORYID #(lf)       AND PC.SUBFAMILYID = T1.SUBFAMILYID#(lf)    LEFT OUTER JOIN HCMPOSITION HCM3 #(lf)        ON HCM3.RECID = PC.INVENTORYMANAGER#(lf)    LEFT OUTER JOIN PRODUCTSUBCATEGORY PSC #(lf)        ON PSC.PRODUCTSUBCATEGORYID = T1.PRODUCTSUBCATEGORYID #(lf)       AND PSC.PRODUCTCATEGORYID = T1.PRODUCTCATEGORYID#(lf)#(tab)LEFT OUTER JOIN INVENTITEMTYPES IIT#(lf)#(tab)#(tab)ON IIT.INVENTITEMTYPEID = T1.INVENTITEMTYPEID #(lf)#(tab)#(tab)AND IIT.PARTITION = T1.PARTITION #(lf)#(tab)#(tab)AND IIT.DATAAREAID = 'VCCR'#(lf)#(tab)LEFT OUTER JOIN LIFECYCLEPRODUCTS LP#(lf)#(tab)#(tab)ON LP.LIFECYCLEID = T1.LIFECYCLEPRODUCTID #(lf)#(tab)#(tab)AND LP.PARTITION = T1.PARTITION #(lf)#(tab)#(tab)AND LP.DATAAREAID = T1.DATAAREAID#(lf)#(tab)LEFT OUTER JOIN ECORESPRODUCT ECO #(lf)#(tab)#(tab)ON ECO.DISPLAYPRODUCTNUMBER = T1.ITEMID #(lf)#(tab)#(tab)AND ECO.PARTITION = T1.PARTITION#(lf)WHERE T1.DATAAREAID IN ('CMER', 'FMCM', '7388')#(lf)"]),
				    #"Filas filtradas" = Table.SelectRows(Source, each ([DATAAREAID] = "cmer")),
				    #"Columnas con nombre cambiado" = Table.RenameColumns(#"Filas filtradas",{{"POSITION", "Encargado Inventario"}})
				in
				    #"Columnas con nombre cambiado"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

