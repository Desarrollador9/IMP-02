	column En_Almacen_Fiscal =
			
			IF(
			    CONTAINERS[ENT_REAL_PATIO_AF] <> DATE(1900, 1, 1) && CONTAINERS[LLEG_REAL_SITIO_DEST] = DATE(1900, 1, 1),
			    "Sí",
			    "No"
			)
