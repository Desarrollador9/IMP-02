	column CREATEDDATETIME
		dataType: dateTime
		formatString: DD/MM/YY
		lineageTag: 0d922fc6-25d6-4107-ab7f-b752d8451572
		summarizeBy: none
		sourceColumn: CREATEDDATETIME

		variation Variation
			isDefault
			relationship: 2c37b44f-2ac1-4638-8417-403185ffab20
			defaultHierarchy: LocalDateTable_884a7c35-462a-446d-ad4d-75fff3147600.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isCustom":true}

	column NOMBRE_PROVEEDOR =
			MAXX(
			    FILTER(
			        VENDOR_NAME,
			        UPPER(VENDOR_NAME[KEY]) = UPPER(Consulta1[DATAAREAID] & Consulta1[ORDERACCOUNT])
			    ),
			    VENDOR_NAME[CONCAT_NAME]
			)
		lineageTag: 6f2ac385-db13-489c-a2d5-bd0a52af7a89

	hierarchy 'CREATEDDATETIME Hierarchy'
		lineageTag: 884e025e-6f40-4192-bf43-96835e82f1ce

		level 'Fecha Creación'
			lineageTag: af0e277e-0da4-4a26-8a03-e0f6c88b54db
			column: CREATEDDATETIME

	partition Consulta1 = m
		mode: import
		source = ```
				let
				    Origen = Sql.Database("SJODB003", "GIAX2012_PROD", [Query="SELECT T1.DATAAREAID, T1.PURCHIDREFERENCE AS PO_MADRE, T1.PURCHID AS PO_HIJA, 
				T1.SERVICEID AS TIPO,T1.ORDERACCOUNT,T1.CREATEDDATETIME,T2.RECID, T2.LINEAMOUNT, T2.CURRENCYCODE AS MONEDA
				FROM PURCHTABLE T1 LEFT OUTER JOIN
				PURCHLINE T2 ON T2.PURCHID = T1.PURCHID AND T2.DATAAREAID = T1.DATAAREAID
				WHERE T1.DATAAREAID = 'CMER' AND T1.PURCHIDREFERENCE <> ''", MultiSubnetFailover=true])
				in
				    Origen
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación

