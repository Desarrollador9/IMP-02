	column Demora? = ```
			
			VAR FechaDevolucionSoloFecha = 
			    IF(
			        NOT ISBLANK(PURCHASE_PBI[FECHA_DEVOLUCION_CONTENEDOR]),
			        DATEVALUE(PURCHASE_PBI[FECHA_DEVOLUCION_CONTENEDOR])
			    )
			RETURN
