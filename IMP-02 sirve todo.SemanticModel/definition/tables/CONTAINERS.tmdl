   NULLIF(T1.INVENTSITEAF, ''),#(lf)    NULLIF(pt.INVENTSITEAF, ''),#(lf)    ''#(lf)) AS SITIO_AF,#(lf)T1.TRANSPORTMETHODLAND AS METODO_TRASLADO_TERRESTRE,#(lf)T1.DUADATE AS FECHA_DUA_TRASLADO,#(lf)T1.APMCOSTPAYMENTDATE AS PAGO_COSTOS_APM,#(lf)T1.AFPLANARRIVALDATE AS PLAN_LLEG_AF,#(lf)T1.AFYARDARRIVEDDATE AS ENT_REAL_PATIO_AF,#(lf)T1.DESTINATIONSITEPLANDATE AS PLAN_SITIO_DESTINO,#(lf)T1.DESTSITEARRIVALDATE AS LLEG_REAL_SITIO_DEST,#(lf)T1.COMPANYUNLOADEDDATE AS REAL_DESCARGA_EMPRESA,#(lf)T1.EMPTYCONTAINERPICKUPNOTICEDATE AS RET_CONT_VACIO,#(lf)DT.NAME AS NOMBRE_CHOFER_AF,#(lf)DT.VATNUM1_2303 AS CEDULA_CHOFER_AF,#(lf)CONTACT.LOCATOR AS CELULAR_CHOFER_AF,#(lf)DT1.NAME AS NOMBRE_CHOFER_FINAL,#(lf)DT1.VATNUM1_2303 AS CEDULA_CHOFER_FINAL,#(lf)CONTACT1.LOCATOR AS CELULAR_CHOFER_FINAL#(lf)FROM PurchContainers T1 #(lf)Right join PurchTable pt on T1.PURCHID = pt.PURCHID and T1.DATAAREAID = pt.DATAAREAID AND T1.PARTITION = pt.PARTITION left outer join#(lf)DirPartyTable dt on dt.recid = t1.afdriver left outer join#(lf)(SELECT T2.PARTY,LEA.LOCATION,LEA.LOCATOR,LEA.RECID,#(lf)ROW_NUMBER() OVER(PARTITION BY T2.PARTY,LEA.TYPE ORDER BY LEA.ISPRIMARY DESC) AS RN#(lf)FROM DirPartyLocation t2 #(lf)LEFT JOIN LOGISTICSLOCATION T3 ON t3.RECID = t2.LOCATION AND T2.PARTITION = T3.PARTITION#(lf)INNER JOIN  LOGISTICSELECTRONICADDRESS LEA ON LEA.LOCATION = T3.RECID AND LEA.PARTITION = T3.PARTITION AND LEA.TYPE = 99) AS CONTACT ON CONTACT.PARTY = DT.RECID AND CONTACT.RN = 1 left outer join#(lf)DirPartyTable dt1 on dt1.recid = t1.finaldriver left outer join#(lf)(SELECT T2.PARTY,LEA.LOCATION,LEA.LOCATOR,LEA.RECID,#(lf)ROW_NUMBER() OVER(PARTITION BY T2.PARTY,LEA.TYPE ORDER BY LEA.ISPRIMARY DESC) AS RN#(lf)FROM DirPartyLocation t2 #(lf)LEFT JOIN LOGISTICSLOCATION T3 ON t3.RECID = t2.LOCATION AND T2.PARTITION = T3.PARTITION#(lf)INNER JOIN  LOGISTICSELECTRONICADDRESS LEA ON LEA.LOCATION = T3.RECID AND LEA.PARTITION = T3.PARTITION AND LEA.TYPE = 99) AS CONTACT1 ON CONTACT1.PARTY = DT1.RECID AND CONTACT1.RN = 1#(lf)WHERE  (pt.SIT_AjustDeparture >= DATEADD(MONTH,-14,GETDATE())   #(lf)         OR pt.SIT_AjustDeparture = '1900-01-01 00:00:00.000')   #(lf)    AND pt.DATAAREAID = 'CMER' #(lf)#(tab)AND COALESCE(NULLIF(T1.SIT_SHIPSTATUS, 0), pt.SIT_SHIPSTATUS) not in (0,2,99)", MultiSubnetFailover=true]),
