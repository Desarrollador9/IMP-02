	column Cuadro_Inventario = ```
			IF(
			    ISBLANK(CATALOGO_PBI[CUADRO]), 
			    "", 
			    FORMAT(CATALOGO_PBI[CUADRO], "General Number")
			) 
			& " " & 
			IF(
			    ISBLANK(CATALOGO_PBI[NOMBRE_CUADRO]), 
			    "", 
			    CATALOGO_PBI[NOMBRE_CUADRO]
