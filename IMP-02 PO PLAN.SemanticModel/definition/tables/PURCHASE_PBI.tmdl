			    TRUE(),
			    ISBLANK(purchase_pbi[LLEGADA_PAIS]), "5.Sin Fecha",
			    _semsLlegada < 0, "6.Ya Llegó",
			    _semsLlegada = 0, "1.T",
			    _semsLlegada = 1, "1.T+1",
			    _semsLlegada = 2, "1.T+2",
