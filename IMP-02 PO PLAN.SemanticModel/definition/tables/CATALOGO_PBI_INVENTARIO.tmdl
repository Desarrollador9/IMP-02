		lineageTag: 77e887fc-37ee-4bd2-84f2-6e8f58562e94

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Vta Diaria Futura en Cajas' = ```
			
			SUMX(
			    CATALOGO_PBI_INVENTARIO,  
			    DIVIDE(
			        CATALOGO_PBI_INVENTARIO[ROTACION_FUTURA],
			        CATALOGO_PBI_INVENTARIO[FACTOR_CAJA]
			    )
			)
			```
		lineageTag: 823f5644-cc7c-4520-aa6f-7dd1d8f74d00

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Inv Tar Exceso' =
			
			VAR _r = [Inv + AF en Tarimas] - [Inv Tar (Seguridad Mínimo)]
			RETURN IF(_r <= 0, 0, _r)
		lineageTag: 11e1ae21-8df9-4081-9660-55d2899cea5e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Flag Sin UND Identidad' =
			VAR es_fila_und = MAX(UnidadesDeMedida[UNIDAD_DESDE]) = "UND"
			VAR tiene_und_identidad =
			    CALCULATE(
			        COUNTROWS(UnidadesDeMedida),
			        UnidadesDeMedida[UNIDAD_DESDE] = "UND",
			        UnidadesDeMedida[UNIDAD_HASTA] = "UND",
			        UnidadesDeMedida[TIPO_CONVERSION] = "ESPECIFICA"
			    )
			RETURN
			IF(
			    es_fila_und && (ISBLANK(tiene_und_identidad) || tiene_und_identidad = 0),
			    "Falta",
			    BLANK()
			)
		displayFolder: Auditoría Unidades
		lineageTag: 9431f54c-6dd1-41e7-9160-888a9906a2f5

