	column Cuadro_Inventario = ```
			IF(
			    ISBLANK(CATALOGO_PBI_SALES[CUADRO]), 
			    "", 
			    FORMAT(CATALOGO_PBI_SALES[CUADRO], "General Number")
			) 
			& " " & 
			IF(
			    ISBLANK(CATALOGO_PBI_SALES[NOMBRE_CUADRO]), 
			    "", 
			    CATALOGO_PBI_SALES[NOMBRE_CUADRO]
			)
