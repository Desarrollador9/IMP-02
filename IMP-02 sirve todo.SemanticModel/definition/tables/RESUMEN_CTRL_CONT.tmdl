	partition RESUMEN_CTRL_CONT = calculated
		mode: import
		source =
				VAR AnclaT = TODAY() - WEEKDAY(TODAY(), 1) + 1
				VAR ContMAR_T   = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT,    PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+7), 0)
				VAR ContMAR_T1  = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+7,  PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+14), 0)
				VAR ContMAR_T2  = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+14, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+21), 0)
				VAR ContMAR_T3  = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+21, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+28), 0)
				VAR ContMAR_T4  = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+28, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+35), 0)
				VAR ContMAR_T5  = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+35, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+42), 0)
				VAR ContMAR_T6  = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+42, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+49), 0)
				VAR ContMAR_T7  = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+49, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+56), 0)
				VAR ContMAR_T8  = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+56, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+63), 0)
				VAR ContMAR_T9  = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+63, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+70), 0)
				VAR ContMAR_Tot = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+70), 0)
				VAR ContPEND_T   = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="PENDIENTE ABORDAJE", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT,    PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+7), 0)
				VAR ContPEND_T1  = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="PENDIENTE ABORDAJE", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+7,  PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+14), 0)
				VAR ContPEND_T2  = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="PENDIENTE ABORDAJE", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+14, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+21), 0)
				VAR ContPEND_T3  = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="PENDIENTE ABORDAJE", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+21, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+28), 0)
				VAR ContPEND_T4  = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="PENDIENTE ABORDAJE", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+28, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+35), 0)
				VAR ContPEND_T5  = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="PENDIENTE ABORDAJE", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+35, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+42), 0)
				VAR ContPEND_T6  = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="PENDIENTE ABORDAJE", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+42, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+49), 0)
				VAR ContPEND_T7  = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="PENDIENTE ABORDAJE", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+49, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+56), 0)
				VAR ContPEND_T8  = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="PENDIENTE ABORDAJE", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+56, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+63), 0)
				VAR ContPEND_T9  = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="PENDIENTE ABORDAJE", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+63, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+70), 0)
				VAR ContPEND_Tot = COALESCE(CALCULATE([Cant_Contenedores], PURCHASE_PBI[ESTADO]="PENDIENTE ABORDAJE", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+70), 0)
				RETURN
				UNION(
				    ROW("Orden", 1, "Concepto", "Contenedores MAR",
				        "T", ContMAR_T, "T+1", ContMAR_T1, "T+2", ContMAR_T2, "T+3", ContMAR_T3, "T+4", ContMAR_T4,
				        "T+5", ContMAR_T5, "T+6", ContMAR_T6, "T+7", ContMAR_T7, "T+8", ContMAR_T8, "T+9", ContMAR_T9,
				        "Total", ContMAR_Tot),
				    ROW("Orden", 2, "Concepto", "Contenedores PEND. ABORDAJE",
				        "T", ContPEND_T, "T+1", ContPEND_T1, "T+2", ContPEND_T2, "T+3", ContPEND_T3, "T+4", ContPEND_T4,
				        "T+5", ContPEND_T5, "T+6", ContPEND_T6, "T+7", ContPEND_T7, "T+8", ContPEND_T8, "T+9", ContPEND_T9,
				        "Total", ContPEND_Tot),
				    ROW("Orden", 3, "Concepto", "Total Contenedores",
				        "T", ContMAR_T+ContPEND_T, "T+1", ContMAR_T1+ContPEND_T1, "T+2", ContMAR_T2+ContPEND_T2, "T+3", ContMAR_T3+ContPEND_T3, "T+4", ContMAR_T4+ContPEND_T4,
				        "T+5", ContMAR_T5+ContPEND_T5, "T+6", ContMAR_T6+ContPEND_T6, "T+7", ContMAR_T7+ContPEND_T7, "T+8", ContMAR_T8+ContPEND_T8, "T+9", ContMAR_T9+ContPEND_T9,
				        "Total", ContMAR_Tot+ContPEND_Tot),
				    ROW("Orden", 4, "Concepto", "Entradas Tarima",
				        "T",   COALESCE(CALCULATE([Entradas_Tarima], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT,    PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+7), 0),
				        "T+1", COALESCE(CALCULATE([Entradas_Tarima], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+7,  PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+14), 0),
				        "T+2", COALESCE(CALCULATE([Entradas_Tarima], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+14, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+21), 0),
				        "T+3", COALESCE(CALCULATE([Entradas_Tarima], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+21, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+28), 0),
				        "T+4", COALESCE(CALCULATE([Entradas_Tarima], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+28, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+35), 0),
				        "T+5", COALESCE(CALCULATE([Entradas_Tarima], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+35, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+42), 0),
				        "T+6", COALESCE(CALCULATE([Entradas_Tarima], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+42, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+49), 0),
				        "T+7", COALESCE(CALCULATE([Entradas_Tarima], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+49, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+56), 0),
				        "T+8", COALESCE(CALCULATE([Entradas_Tarima], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+56, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+63), 0),
				        "T+9", COALESCE(CALCULATE([Entradas_Tarima], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT+63, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+70), 0),
				        "Total", COALESCE(CALCULATE([Entradas_Tarima], PURCHASE_PBI[ESTADO]="MAR", PURCHASE_PBI[LLEGADA_PAIS]>=AnclaT, PURCHASE_PBI[LLEGADA_PAIS]<AnclaT+70), 0)),
				    ROW("Orden", 5, "Concepto", "Estimación Salida Bodega",
				        "T", 34, "T+1", 34, "T+2", 34, "T+3", 34, "T+4", 34,
				        "T+5", 34, "T+6", 34, "T+7", 34, "T+8", 34, "T+9", 34,
				        "Total", 340),
				    ROW("Orden", 6, "Concepto", "Estimación Total Capacidad Traer",
				        "T", -(ContMAR_T-34), "T+1", -(ContMAR_T1-34), "T+2", -(ContMAR_T2-34), "T+3", -(ContMAR_T3-34), "T+4", -(ContMAR_T4-34),
				        "T+5", -(ContMAR_T5-34), "T+6", -(ContMAR_T6-34), "T+7", -(ContMAR_T7-34), "T+8", -(ContMAR_T8-34), "T+9", -(ContMAR_T9-34),
				        "Total", -(ContMAR_Tot-340))
				)

	annotation PBI_Id = df68c09f0909459cb475df992c31c985

