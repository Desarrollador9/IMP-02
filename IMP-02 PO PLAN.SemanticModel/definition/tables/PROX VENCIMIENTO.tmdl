	column 'FECHA PROX VENCIMIENTO'
		dataType: dateTime
		formatString: DD/MM/YY
		lineageTag: e45698a1-60ab-427b-ac3d-6264e6dfc472
		summarizeBy: none
		sourceColumn: FECHA PROX VENCIMIENTO

		variation Variación
			isDefault
			relationship: 43f416c6-53bd-483f-9ebc-9f803252349e
			defaultHierarchy: LocalDateTable_c0cbcc06-f8c3-49c5-8b39-9747b02bd9e4.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isCustom":true}

	partition 'PROX VENCIMIENTO' = m
		mode: import
		source =
				let
				    Origen = Sql.Database("SJODB003", "GIAX2012_PROD", [Query="SELECT #(lf)#(tab)INV.ITEMID,#(lf)#(tab)INV.DATAAREAID,#(lf)    MIN(EXPDATE) AS [FECHA PROX VENCIMIENTO] FROM INVENTSUM AS INV INNER JOIN#(lf)INVENTDIM AS I WITH (NOLOCK) ON I.INVENTDIMID = INV.INVENTDIMID AND I.DATAAREAID = dbo.Get_VirtualCompByTable(INV.DATAAREAID, N'INVENTDIM') AND I.PARTITION = INV.PARTITION LEFT OUTER JOIN#(lf)INVENTBATCH AS IB ON IB.INVENTBATCHID = I.INVENTBATCHID AND IB.DATAAREAID = INV.DATAAREAID AND IB.ITEMID = INV.ITEMID AND IB.PARTITION = INV.PARTITION#(lf)WHERE INV.PHYSICALINVENT > 0 AND INV.DATAAREAID = 'CMER' AND EXPDATE >= GETDATE()#(lf)GROUP BY INV.ITEMID,INV.DATAAREAID", MultiSubnetFailover=true])
				in
				    Origen

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

