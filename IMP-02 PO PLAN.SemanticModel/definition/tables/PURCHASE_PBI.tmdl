			VAR PosGuion = FIND("-", ProveedorCompleto, 1, LEN(ProveedorCompleto)) 
			VAR Proveedor = IF(PosGuion > 0, LEFT(ProveedorCompleto, PosGuion - 1), ProveedorCompleto) 
