	column SEM = ```
			
			VAR Week = WEEKNUM(TODAY(), 1)
			VAR YearActual = YEAR(TODAY())
			VAR AnnioVenta = Sales[ANNIO]
			VAR SemanaVenta = Sales[SEMANA]
			
			-- Calcular semana absoluta (considerando año)
			VAR SemanaAbsolutaActual = YearActual * 52 + Week
			VAR SemanaAbsolutaVenta = AnnioVenta * 52 + SemanaVenta
			VAR Diferencia = SemanaAbsolutaActual - SemanaAbsolutaVenta
			
			RETURN 
			    SWITCH(
			        TRUE(),
			        Diferencia = 0, "t",
			        Diferencia = 1, "t-1",
			        Diferencia = 2, "t-2",
			        Diferencia = 3, "t-3",
			        Diferencia > 0, "t-" & Diferencia,
			        "future"
			    )
			```
		lineageTag: ff433109-6c35-4bbd-9fec-f447d9e50fe7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

