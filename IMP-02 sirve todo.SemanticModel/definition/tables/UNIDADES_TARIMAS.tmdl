	partition UNIDADES_TARIMAS = m
		mode: import
		source =
				let
				    Source = Sql.Database("SJODB002", "GIAX2012_PROD", [Query="SELECT T3.RECID, T1.ITEMID, T3.FACTOR, T4.SYMBOL AS UNTIFROM, T5.SYMBOL AS UNITTO, T1.DATAAREAID#(lf)FROM     INVENTTABLE AS T1 INNER JOIN#(lf)                  ECORESPRODUCT AS T2 ON T1.PRODUCT = T2.RECID INNER JOIN#(lf)                  UNITOFMEASURECONVERSION AS T3 ON T2.RECID = T3.PRODUCT LEFT OUTER JOIN#(lf)                  UNITOFMEASURE AS T4 ON T3.FROMUNITOFMEASURE = T4.RECID LEFT OUTER JOIN#(lf)                  UNITOFMEASURE AS T5 ON T3.TOUNITOFMEASURE = T5.RECID INNER JOIN#(lf)#(tab)#(tab)#(tab)#(tab)  INVENTTABLEMODULE AS T6 ON T6.MODULETYPE = 1 AND T6.ITEMID = T1.ITEMID AND T6.DATAAREAID = T1.DATAAREAID AND T5.SYMBOL = T6.UNITID#(lf)WHERE T1.DATAAREAID = 'CMER' AND T4.SYMBOL = 'TARIMA'", MultiSubnetFailover=true])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

