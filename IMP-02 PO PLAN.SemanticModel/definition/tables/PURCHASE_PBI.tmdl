	/// Cuenta cuántas OCs hijas tiene cada OC madre
	measure 'Cantidad OCs Hijas' =
			VAR OCMadreActual = SELECTEDVALUE('PURCHASE_PBI'[PO_MADRE])
			VAR OCActual = SELECTEDVALUE('PURCHASE_PBI'[PURCHID])
			RETURN
			IF(
			    NOT ISBLANK(OCMadreActual),
			    CALCULATE(
			        DISTINCTCOUNT('PURCHASE_PBI'[PURCHID]),
			        FILTER(
			            ALL('PURCHASE_PBI'[PURCHID], 'PURCHASE_PBI'[PO_MADRE]),
			            'PURCHASE_PBI'[PO_MADRE] = OCMadreActual &&
			            'PURCHASE_PBI'[PURCHID] <> OCMadreActual
			        )
			    ),
			    BLANK()
			)
		formatString: #,0
		lineageTag: e339ae93-20ce-409e-a210-662c4754b298

	/// Identifica si la OC es una madre sin hijas
	measure 'Estado OC Madre-Hija' =
			VAR OCMadreActual = SELECTEDVALUE('PURCHASE_PBI'[PO_MADRE])
			VAR OCActual = SELECTEDVALUE('PURCHASE_PBI'[PURCHID])
			VAR EsMadre = OCMadreActual = OCActual
			VAR CantidadHijas = [Cantidad OCs Hijas]
			RETURN
			IF(
			    EsMadre && CantidadHijas = 0,
			    "Sin Hijas",
			    IF(EsMadre && CantidadHijas > 0, "Con Hijas", "Es Hija")
			)
		lineageTag: 61296a64-6109-4a41-9e72-640d6a430335

	/// Cuenta solo las OCs Madres (internacionales) que NO tienen OCs hijas asociadas
	measure 'Total OCs Madres Sin Hijas' = ```
			CALCULATE(
			    DISTINCTCOUNT('PURCHASE_PBI'[PURCHID]),
			    FILTER(
			        'PURCHASE_PBI',
			        VAR OCActual = 'PURCHASE_PBI'[PURCHID]
			        VAR POMadre = 'PURCHASE_PBI'[PO_MADRE]
			        VAR EsMadre = NOT ISBLANK(POMadre) && OCActual = POMadre
			        VAR TieneHijas = 
			            CALCULATE(
			                COUNTROWS('PURCHASE_PBI'),
			                FILTER(
			                    ALL('PURCHASE_PBI'),
			                    'PURCHASE_PBI'[PO_MADRE] = OCActual &&
			                    'PURCHASE_PBI'[PURCHID] <> OCActual
			                )
			            ) > 0
			        RETURN EsMadre && NOT TieneHijas
			    )
			)
			```
		formatString: #,0
		lineageTag: 4fd4fc18-f71a-4908-bad8-76070940556d

	/// Indicador visual: muestra icono de alerta para OCs madre sin hijas
	measure 'Alerta Flete' =
			VAR OCMadreActual = SELECTEDVALUE('PURCHASE_PBI'[PO_MADRE])
			VAR OCActual = SELECTEDVALUE('PURCHASE_PBI'[PURCHID])
			VAR EsMadre = NOT ISBLANK(OCMadreActual) && OCActual = OCMadreActual
			VAR CantidadHijas = [Cantidad OCs Hijas]
			RETURN
			IF(
			    EsMadre && CantidadHijas = 0,
			    "⚠️ Sin Flete Gestionado",
			    IF(EsMadre && CantidadHijas > 0, "✅ Flete OK", "")
			)
		lineageTag: 9c65a457-e84d-4d38-beaa-e8e6ebc84b40

