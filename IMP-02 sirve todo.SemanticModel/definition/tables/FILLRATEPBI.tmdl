table FILLRATEPBI
	lineageTag: 777404f6-1af7-4d57-86ae-c15b043876c1

	measure '% Art Faltantes' =
			DIVIDE(
			    CALCULATE(COUNTROWS(FILLRATEPBI), FILLRATEPBI[ESTADOEXISTENCIAS] = "FALTANTE"),
			    COUNTROWS(FILLRATEPBI)
			)
		formatString: 0.00%
		lineageTag: 8f33d966-2332-4a7f-8d99-f4903d0fb21c

	measure %Ventas =
			
			VAR _denom =
			    CALCULATE(
			        SUM(FILLRATEPBI[VENTAS]),
			        ALLSELECTED(),
			        ALL(FILLRATEPBI[ESTADOEXISTENCIAS])
			    )
			VAR _pctFila = DIVIDE(SUM(FILLRATEPBI[VENTAS]), _denom)
			VAR _esFilaDetalle =
			    ISINSCOPE(CATALOGO_PBI[FAMILYID])
			    || ISINSCOPE(CATALOGO_PBI[SUBFAMILIA])
			    || ISINSCOPE(CATALOGO_PBI[PRODUCTCATEGORYID])
			    || ISINSCOPE(CATALOGO_PBI[SUBCATEGORIA])
			    || ISINSCOPE(PURCHASE_PBI[ARTICULO_CONCAT])
			    || ISINSCOPE(CATALOGO_PBI[CICLO_VIDA])
			RETURN
			    IF(
			        _esFilaDetalle,
			        _pctFila,
			        SUMX(
			            VALUES(CATALOGO_PBI[FAMILYID]),
			            VAR _items = CALCULATETABLE(VALUES(CATALOGO_PBI_INVENTARIO[ITEMID]))
			            VAR _num = CALCULATE(SUM(FILLRATEPBI[VENTAS]), _items)
			            RETURN DIVIDE(_num, _denom)
			        )
			    )
		lineageTag: 9f8b268f-143d-44f3-85ff-0c0c18341c57

		annotation PBI_FormatHint = {"isGeneralNumber":true}

