	column Moneda_Costos = ```
			
			VAR TotalLineAmount =   
			    CALCULATE(  
			        SUM(PURCHASE_PBI[LINEAMOUNT]),  
			        ALLEXCEPT(PURCHASE_PBI, PURCHASE_PBI[PURCHID])  
