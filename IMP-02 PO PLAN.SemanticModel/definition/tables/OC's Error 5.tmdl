	partition 'OC''s Error 5' = m
		mode: import
		source =
				let
				    Origen = Sql.Database("sjodb002", "giax2012_prod", [Query="#(tab)SELECT #(lf)    tt.PURCHID,#(lf)    tt.DATAAREAID,#(lf)    tt.PARTITION,#(lf)    tt.ORDERACCOUNT,#(lf)    CASE #(lf)        WHEN COUNT(t2.REFRECID) > 0 THEN 'Pendiente'#(lf)        WHEN COUNT(t.INVOICEID) = 0 THEN 'Sin Factura'#(lf)        ELSE 'Pagada'#(lf)    END AS EstadoPago,#(lf)    tt.BookingNumber,#(lf)    t.invoiceid#(lf)FROM purchtable tt#(lf)LEFT OUTER JOIN vendinvoicejour t #(lf)    ON t.PURCHID = tt.PURCHID #(lf)    AND t.DATAAREAID = tt.DATAAREAID#(lf)LEFT OUTER JOIN vendtrans t1 #(lf)    ON t1.INVOICE = t.INVOICEID #(lf)    AND t1.ACCOUNTNUM = t.ORDERACCOUNT #(lf)    AND t1.DATAAREAID = t.DATAAREAID #(lf)    AND t1.PARTITION = t.PARTITION#(lf)LEFT OUTER JOIN vendtransopen t2 #(lf)    ON t1.RECID = t2.REFRECID #(lf)    AND t1.DATAAREAID = t2.DATAAREAID #(lf)    AND t1.PARTITION = t2.PARTITION#(lf)WHERE tt.DATAAREAID = 'cmer' #(lf)    AND tt.PARTITION = 5637144576#(lf)    AND (tt.SIT_AjustDeparture >= DATEADD(MONTH, -12, GETDATE()))#(lf)    AND tt.SIT_SHIPSTATUS NOT IN (0, 2, 99)#(lf)    AND tt.BookingNumber = ''#(lf)GROUP BY #(lf)    tt.PURCHID,#(lf)    tt.DATAAREAID,#(lf)    tt.PARTITION,#(lf)    tt.ORDERACCOUNT,#(lf)    tt.SIT_AjustDeparture,#(lf)    tt.BookingNumber,#(lf)    t.invoiceid#(lf)HAVING #(lf)    COUNT(t2.REFRECID) = 0       #(lf)    AND COUNT(t.INVOICEID) > 0  ", MultiSubnetFailover=true])
				in
				    Origen

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

