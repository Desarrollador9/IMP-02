	column 'Error 2' = ```
			
			VAR CantOrdenada = PURCHASE_PBI[CANTIDAD]
			VAR CantRecibida = 
			    CALCULATE(
			        SUM(RECEPCIONES[CANT_RECIBIDO]),
			        FILTER(
			            ALL(RECEPCIONES),
			            RECEPCIONES[KEY_RECEP] = PURCHASE_PBI[KEY_RECEP]
			        )
			    )
			VAR EsParcial = CantRecibida > 0 && CantOrdenada - CantRecibida > 0
			RETURN
			    IF(
			        PURCHASE_PBI[ESTADO] = "ALMACÉN FISCAL" && EsParcial,
			        "Error",
			        "No Error"
			    )
			```
		lineageTag: 610d95f2-8052-474f-a655-0e075ff79212
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

