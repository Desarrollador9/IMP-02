	partition 'PAGOS OC''s' = m
		mode: import
		source =
				let
				    Origen = Sql.Database("SJODB003", "GIAX2012_PROD", [Query="SELECT #(lf)    tt.PURCHID,#(lf)    tt.DATAAREAID,#(lf)    tt.PARTITION,#(lf)    tt.ORDERACCOUNT,#(lf)    CASE #(lf)        WHEN COUNT(t2.REFRECID) > 0 THEN 'Pendiente'#(lf)        WHEN COUNT(t.INVOICEID) = 0 THEN 'Sin Factura'#(lf)        ELSE 'Pagada'#(lf)    END AS EstadoPago,#(lf)    tt.BookingNumber,#(lf)    t.invoiceid#(lf)FROM purchtable tt#(lf)LEFT OUTER JOIN vendinvoicejour t #(lf)    ON t.PURCHID = tt.PURCHID #(lf)    AND t.DATAAREAID = tt.DATAAREAID#(lf)LEFT OUTER JOIN vendtrans t1 #(lf)    ON t1.INVOICE = t.INVOICEID #(lf)#(tab)AND t1.VOUCHER = t.LEDGERVOUCHER#(lf)    AND t1.ACCOUNTNUM = t.INVOICEACCOUNT #(lf)    AND t1.DATAAREAID = t.DATAAREAID #(lf)    AND t1.PARTITION = t.PARTITION#(lf)LEFT OUTER JOIN vendtransopen t2 #(lf)    ON t1.RECID = t2.REFRECID #(lf)    AND t1.DATAAREAID = t2.DATAAREAID #(lf)    AND t1.PARTITION = t2.PARTITION#(lf)WHERE tt.DATAAREAID = 'cmer' #(lf)    AND tt.PARTITION = 5637144576#(lf)    AND (tt.SIT_AjustDeparture >= DATEADD(MONTH,-12,GETDATE()) #(lf)         OR tt.SIT_AjustDeparture = '1900-01-01 00:00:00.000')   #(lf)#(lf)GROUP BY #(lf)    tt.PURCHID,#(lf)    tt.DATAAREAID,#(lf)    tt.PARTITION,#(lf)    tt.ORDERACCOUNT,#(lf)    tt.SIT_AjustDeparture,#(lf)    tt.BookingNumber,#(lf)    t.invoiceid", MultiSubnetFailover=true]),
				    #"Filas ordenadas" = Table.Sort(Origen,{{"PURCHID", Order.Ascending}})
				in
				    #"Filas ordenadas"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

