	partition CATALOGO_PBI = m
		mode: import
		source = ```
				let
				    Source = Sql.Database("SJODB002", "GIAX2012_PROD", [MultiSubnetFailover=true, Query="
				        SELECT 
				            C.*,
				            IT.WMSBALANCEPICKGROUPID AS ZONA_ID,
				            WPG.DESCRIPTION AS ZONA_DESCRIPCION
				        FROM dbo.CATALOGO_PBI C
				        LEFT JOIN dbo.INVENTTABLE IT 
				            ON IT.ITEMID = C.ITEMID 
				            AND IT.DATAAREAID = C.DATAAREAID
				        LEFT JOIN dbo.WMSBALANCEPICKINGGROUP WPG
				            ON WPG.ID = IT.WMSBALANCEPICKGROUPID
				            AND WPG.DATAAREAID = C.DATAAREAID
				    "])
				in
				    Source
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

