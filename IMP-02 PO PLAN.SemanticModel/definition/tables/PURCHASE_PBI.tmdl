	/// Indica si es OC Madre, Hija, o Madre sin Hijas
	column 'Clasificacion OC' = ```
			VAR EsMadre = 'PURCHASE_PBI'[PURCHID] = 'PURCHASE_PBI'[PO_MADRE]
			VAR CantidadHijas = 
			    CALCULATE(
			        COUNTROWS('PURCHASE_PBI'),
			        FILTER(
			            'PURCHASE_PBI',
			            'PURCHASE_PBI'[PO_MADRE] = EARLIER('PURCHASE_PBI'[PURCHID]) &&
			            'PURCHASE_PBI'[PURCHID] <> EARLIER('PURCHASE_PBI'[PURCHID])
			        )
			    )
			RETURN
			SWITCH(
			    TRUE(),
			    EsMadre && CantidadHijas = 0, "Madre Sin Hijas",
			    EsMadre && CantidadHijas > 0, "Madre Con Hijas",
			    "OC Hija"
			)
			```
		lineageTag: a9712124-4252-4a5a-a45f-6dde57eab30a

	/// Cuenta el número de OCs hijas que tiene cada OC madre
	column 'Num OCs Hijas' =
			IF(
			    'PURCHASE_PBI'[PURCHID] = 'PURCHASE_PBI'[PO_MADRE],
			    CALCULATE(
			        COUNTROWS('PURCHASE_PBI'),
			        FILTER(
			            'PURCHASE_PBI',
			            'PURCHASE_PBI'[PO_MADRE] = EARLIER('PURCHASE_PBI'[PURCHID]) &&
			            'PURCHASE_PBI'[PURCHID] <> EARLIER('PURCHASE_PBI'[PURCHID])
			        )
			    ),
			    BLANK()
			)
		dataType: int64
		formatString: #,0
		lineageTag: 5c791bea-c473-4ff4-8108-50ca61e1d6a6

