			VAR FolderPath = "Documentos%20compartidos/Centro%20de%20Documentaci%C3%B3n%20Grupo%20Inteca%20Digitalizado/Proveedores/Transacciones%20con%20proveedores%20internacionales/OC%C2%B4s/"
			
			VAR OC_Number = SUBSTITUTE(PURCHASE_PBI[PURCHID], "_", "-") 
			VAR OC_Cleaned = IF(LEFT(OC_Number, 3) = "OC-", OC_Number, "OC-" & OC_Number)
			
			VAR ProveedorCompleto = PURCHASE_PBI[ORDERACCOUNT]
			
			VAR Subcarpeta_Documentacion= "7.%20TRANSPORTE%20TERRESTRE"
			
			VAR Subcarpeta2= "7.05%20DUA%20transito"
			
			VAR FolderURL = BaseURL & FolderPath & "cmer-" & OC_Cleaned & "-" & ProveedorCompleto & "/" & Subcarpeta_Documentacion & "/" & Subcarpeta2
			
			RETURN FolderURL
			```
		lineageTag: 21c1a99d-02ac-4cd2-a87f-8e12554a31ae
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

