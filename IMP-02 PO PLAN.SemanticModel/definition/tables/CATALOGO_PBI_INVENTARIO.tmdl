	measure 'Vta Diaria 3S en Cajas' = ```
			
			SUMX(
			    CATALOGO_PBI_INVENTARIO,  
			    DIVIDE(
			        CATALOGO_PBI_INVENTARIO[ROTACION_3S],
			        CATALOGO_PBI_INVENTARIO[FACTOR_CAJA]
			    )
			)
			```
		lineageTag: 33ae3d0c-a3aa-4254-ae12-d5409ac692cc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Vta Diaria 3M en Cajas' = ```
			
			SUMX(
			    CATALOGO_PBI_INVENTARIO,  
			    DIVIDE(
			        CATALOGO_PBI_INVENTARIO[ROTACION_3M],
			        CATALOGO_PBI_INVENTARIO[FACTOR_CAJA]
