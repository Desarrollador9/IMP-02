	column AWBDOCUMENTS
		dataType: string
		lineageTag: c826dec4-e6a4-4532-acf5-7aca821e41e8
		summarizeBy: none
		sourceColumn: AWBDOCUMENTS

		annotation SummarizationSetBy = Automatic

	column 'Etiqueta Semana' =
			
			VAR HoyFecha = TODAY()
			VAR InicioSemanaActual = HoyFecha - WEEKDAY(HoyFecha, 1) + 1  // Domingo de esta semana
			VAR FechaLlegada = PURCHASE_PBI[LLEGADA_PAIS]
			VAR InicioSemanaLlegada = FechaLlegada - WEEKDAY(FechaLlegada, 1) + 1  // Domingo de la semana de llegada
			VAR DiferenciaSemanas = INT((InicioSemanaLlegada - InicioSemanaActual) / 7)
			RETURN
			    IF(
			        ISBLANK(FechaLlegada) || FechaLlegada = DATE(1900,1,1),
			        "Sin Fecha",
			        IF(
			            DiferenciaSemanas < 0 || DiferenciaSemanas > 9,
			            BLANK(),
			            IF(
			                DiferenciaSemanas = 0,
			                "T",
			                "T+" & DiferenciaSemanas
			            )
			        )
			    )
		lineageTag: 8343c397-4cb1-4fce-a02b-dca114a00ef2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Semana Completa' =
			
			VAR NumSemana = PURCHASE_PBI[Sem Llegada al Pais]
			VAR Etiqueta = PURCHASE_PBI[Etiqueta Semana]
			RETURN
			    IF(
			        ISBLANK(Etiqueta) || Etiqueta = "Sin Fecha",
			        Etiqueta,
			        Etiqueta & " (" & NumSemana & ")"
			    )
		lineageTag: b7fc26dc-3ff2-4b5d-bea2-5bd079db3aa1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Sem Llegada al Pais' =
			
			IF(
			    ISBLANK(PURCHASE_PBI[LLEGADA_PAIS]),
			    BLANK(),
			    WEEKNUM(PURCHASE_PBI[LLEGADA_PAIS], 1)
			)
		formatString: 0
		lineageTag: 06154713-754f-4e16-a6d9-7ef785be60ba
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

