		dataType: dateTime
		formatString: General Date
		lineageTag: c2ff16cd-2f26-498c-b5cd-d1153c18c426
		summarizeBy: none
		sourceColumn: AJUSTADA_ARRIBO_OC

		variation Variación
			isDefault
			relationship: 6009436f-3f9e-411a-b14a-a14831c3dbc5
			defaultHierarchy: LocalDateTable_ea50f880-86bc-44eb-9fa3-95c8e6b25440.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'Ubicación Actual' =
			
			VAR FechaPuerto = CONTAINERS[AJUSTADA_ARRIBO_OC]
			VAR FechaAlmacen = CONTAINERS[ENT_REAL_PATIO_AF]
			VAR FechaBodega = CONTAINERS[LLEG_REAL_SITIO_DEST]
			VAR FechaMaxima = MAX(FechaPuerto, MAX(FechaAlmacen, FechaBodega))
			RETURN
			    SWITCH(TRUE(),
			        FechaMaxima = FechaPuerto,"Puerto",
			        FechaMaxima = FechaAlmacen, CONTAINERS[SITIO_AF],
			        FechaMaxima = FechaBodega, CONTAINERS[SITIO_FINAL],
			        BLANK()
			    )
		lineageTag: f313aaf0-571e-4b51-b1b0-752eafc893cb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

