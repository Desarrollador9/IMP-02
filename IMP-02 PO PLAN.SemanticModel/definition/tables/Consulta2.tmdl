table Consulta2
	lineageTag: becfde39-83a7-4c7c-bf22-043b18c297b9

	measure Inv_Localidad_Ctx = ```
			
			VAR _val = 
			    CALCULATE(
			        SUM( Consulta2[inventario_contenedor] ),
			        ALLEXCEPT( Consulta2, Consulta2[localidad], Consulta2[articulo] )
			    )
			RETURN
			    IF( ISBLANK(_val), BLANK(), _val )
			```
		lineageTag: f1a9e249-d712-4774-8780-a18d48c7ae0e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column localidad
		dataType: string
		lineageTag: e1fdf4b4-cb9c-4ca7-955e-d87afbd6d8e3
		summarizeBy: none
		sourceColumn: localidad

		annotation SummarizationSetBy = Automatic

	column articulo
		dataType: string
		lineageTag: b5aad75c-2e20-4116-a035-aa52bbc74442
		summarizeBy: none
		sourceColumn: articulo

		annotation SummarizationSetBy = Automatic

	column inventario_contenedor
		dataType: double
		lineageTag: eac591ee-4bdf-434f-bb59-e73e6d10498d
		summarizeBy: sum
		sourceColumn: inventario_contenedor

