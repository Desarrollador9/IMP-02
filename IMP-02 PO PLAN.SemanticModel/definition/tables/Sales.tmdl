	partition Sales = m
		mode: import
		source =
				let
				    Source = Sql.Database("SJODB003", "GIAX2012_PROD", [Query="WITH COGS AS (#(lf)    SELECT#(lf)        DATAAREAID,#(lf)        INVOICEID,#(lf)        INVENTTRANSID,#(lf)        SUM(COGS) AS Total_COGS#(lf)    FROM#(lf)        CostOfGoodsSold#(lf)    GROUP BY#(lf)        DATAAREAID,#(lf)        INVOICEID,#(lf)        INVENTTRANSID#(lf))#(lf)#(lf)SELECT#(lf)    SUM(T1.LINEAMOUNTMST) AS MONTO_VENTA,#(lf)    DATEPART(WEEK, T1.INVOICEDATE) AS SEMANA,#(lf)    DATEPART(YEAR, T1.INVOICEDATE) AS ANNIO,#(lf)    T1.ITEMID,#(lf)    T1.DATAAREAID,#(lf)    T1.DATAAREAID + T1.ITEMID AS KEY_GEN,#(lf)    SUM(T1.INVENTQTY) AS CANTIDAD,#(lf)    SUM(T1.LINEAMOUNTMST - ISNULL(C.Total_COGS, 0)) AS ContribucionBruta,#(lf)#(tab)t2.INVOICEACCOUNT as CodCliente,#(lf)#(tab)SUM(T1.INVENTQTY * T3.FACTOR) AS Venta_Especial,#(lf)#(tab)T3.SYMBOL AS UNIDADESPECIAL,#(lf)#(tab)MAX(T3.FACTOR) AS FACTOR_UND_ESP,#(lf)#(tab)T1.INVOICEDATE,#(lf)#(tab)CASE #(lf)            WHEN ISNULL(T50.ROLESPECIFICID, '') = '' #(lf)            THEN T51.ROLESPECIFICID #(lf)            ELSE T50.ROLESPECIFICID #(lf)        END AS Vendedor#(lf)FROM#(lf)    CUSTINVOICETRANS T1#(lf)LEFT JOIN CUSTINVOICEJOUR T2 ON T2.INVOICEID=T1.INVOICEID AND T2.DATAAREAID=T1.DATAAREAID AND T2.PARTITION=T1.PARTITION and t1.INVOICEDATE=t2.INVOICEDATE and t1.SALESID=t2.SALESID#(lf)LEFT JOIN#(lf)    COGS C ON T1.DATAAREAID = C.DATAAREAID#(lf)               AND T1.INVOICEID = C.INVOICEID#(lf)               AND T1.INVENTTRANSID = C.INVENTTRANSID#(lf)LEFT OUTER JOIN SPECIAL_UNIT1 T3 ON T3.DISPLAYPRODUCTNUMBER = T1.ITEMID#(lf)LEFT JOIN RoleSpecificAddressGenPBI T50 WITH (NOLOCK)#(lf)        ON T50.REFRECID = T2.ADDRESSREFRECID#(lf)        AND T50.DATAAREAID = T2.DATAAREAID#(lf)        AND T50.ROLEID LIKE '%Vendedor%' #(lf)LEFT JOIN RoleSpecificCustGenPBI T51 WITH (NOLOCK)#(lf)        ON T51.ACCOUNTNUM = T2.INVOICEACCOUNT #(lf)        AND T51.DATAAREAID = T2.DATAAREAID#(lf)        AND T51.ROLEID LIKE '%Vendedor%' #(lf)WHERE#(lf)    T1.DATAAREAID IN ('CMER', 'FMCM')#(lf)    AND T1.INVOICEDATE >= DATEADD(WEEK, -14, GETDATE())#(lf)    AND T1.PARTITION = 5637144576#(lf)GROUP BY#(lf)    DATEPART(WEEK, T1.INVOICEDATE),#(lf)    DATEPART(YEAR, T1.INVOICEDATE),#(lf)    T1.ITEMID,#(lf)    T1.DATAAREAID,#(lf)#(tab)t2.INVOICEACCOUNT,#(lf)#(tab)T3.SYMBOL,#(lf)#(tab)T1.INVOICEDATE,#(lf)#(tab)T50.ROLESPECIFICID,#(lf)#(tab)T51.ROLESPECIFICID", MultiSubnetFailover=true]),
				    #"Valor reemplazado" = Table.ReplaceValue(Source,null,"ND",Replacer.ReplaceValue,{"Vendedor"}),
				    #"Personalizada agregada" = Table.AddColumn(#"Valor reemplazado", "key_vendedor", each [DATAAREAID]&[Vendedor])
				in
				    #"Personalizada agregada"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación

