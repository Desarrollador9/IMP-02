	column nombre_articulo
		dataType: string
		lineageTag: 54dae1b9-0df5-4ca9-82ab-fdaae240fa36
		summarizeBy: none
		sourceColumn: nombre_articulo

		annotation SummarizationSetBy = Automatic

	partition Consulta2 = m
		mode: import
		source =
				let
				    Source = Sql.Database("SJODB002", "GIAX2012_PROD", [MultiSubnetFailover=true]),
				    dbo_Localidades = Source{[Schema="dbo", Item="Localidades_View_PBI"]}[Data],
				    Filtro_Empresa = Table.SelectRows(dbo_Localidades, each [empresa] = "cmer"),
				    Filtro_Almacen = Table.SelectRows(Filtro_Empresa, each [almacen] = "F20"),
				    Filtro_Contenedor = Table.SelectRows(Filtro_Almacen, each Text.Length([localidad]) = 4 and Text.StartsWith([localidad], "C")),
				    Filtro_Articulo = Table.SelectRows(Filtro_Contenedor, each [articulo] <> null and [articulo] <> ""),
				    Columnas = Table.SelectColumns(Filtro_Articulo, {"localidad", "articulo", "inventario_fisico"}),
				    Agrupado = Table.Group(Columnas, {"localidad", "articulo"}, {{"inventario_contenedor", each List.Sum([inventario_fisico]), type number}}),
				    dbo_Catalogo = Source{[Schema="dbo", Item="CATALOGO_PBI"]}[Data],
				    Catalogo_Filtrado = Table.SelectRows(dbo_Catalogo, each [DATAAREAID] = "cmer"),
				    Catalogo_Cols = Table.SelectColumns(Catalogo_Filtrado, {"ITEMID", "PRODUCTNAME"}),
				    JoinNombre = Table.NestedJoin(Agrupado, {"articulo"}, Catalogo_Cols, {"ITEMID"}, "CAT", 1),
				    ExpandNombre = Table.ExpandTableColumn(JoinNombre, "CAT", {"PRODUCTNAME"}, {"nombre_articulo"})
				in
				    ExpandNombre

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

