			VAR FolderPath = "Documentos%20compartidos/Centro%20de%20Documentaci%C3%B3n%20Grupo%20Inteca%20Digitalizado/Proveedores/Transacciones%20con%20proveedores%20internacionales/OC%C2%B4s/"
			
