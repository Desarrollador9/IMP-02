table CATALOGO_PBI_SALES
	lineageTag: b652ff6b-f399-4c0e-b9c8-c5740ac3b111

	measure VT1_EstBase_Division = ```
			
			VAR VT1_Value = 
			    CALCULATE(
			        [MedidasAgrupadasCalculadas], 
			        Grupos2[Medida] = "VT-1"
			    )
			VAR EstBase_Value = 
			    CALCULATE(
			        [MedidasAgrupadasCalculadas], 
			        Grupos2[Medida] = "Est Base"
			    )
			RETURN
			    DIVIDE(VT1_Value, EstBase_Value, 0)
			
			```
		lineageTag: 569074b3-96f8-46d5-8ccd-db173c5d4b44

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

