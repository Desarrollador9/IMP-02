	/// Extrae OC desde txt. Patron 1: OC-XXXXXXXX explicito. Patron 2: PO seguido de 5 o 6 digitos. Patron 3: OC espacio seguido de 5 o 6 digitos (sin guion).
	column OC_Extraida =
			VAR txt_up = UPPER( TRIM( COALESCE( VENDTRANS[txt], "" ) ) )
			
			-- PATRON 1: OC- explicito con 8 digitos
			VAR pos_oc = SEARCH( "OC-", txt_up, 1, 0 )
			VAR oc_d1 = IF( pos_oc > 0, MID( txt_up, pos_oc+3, 1 ), "X" )
			VAR oc_d2 = IF( pos_oc > 0, MID( txt_up, pos_oc+4, 1 ), "X" )
			VAR oc_d3 = IF( pos_oc > 0, MID( txt_up, pos_oc+5, 1 ), "X" )
			VAR oc_d4 = IF( pos_oc > 0, MID( txt_up, pos_oc+6, 1 ), "X" )
			VAR oc_d5 = IF( pos_oc > 0, MID( txt_up, pos_oc+7, 1 ), "X" )
			VAR oc_d6 = IF( pos_oc > 0, MID( txt_up, pos_oc+8, 1 ), "X" )
			VAR oc_d7 = IF( pos_oc > 0, MID( txt_up, pos_oc+9, 1 ), "X" )
			VAR oc_d8 = IF( pos_oc > 0, MID( txt_up, pos_oc+10, 1 ), "X" )
			VAR oc_valido =
			    pos_oc > 0
			    && ( oc_d1>="0" && oc_d1<="9" ) && ( oc_d2>="0" && oc_d2<="9" )
			    && ( oc_d3>="0" && oc_d3<="9" ) && ( oc_d4>="0" && oc_d4<="9" )
			    && ( oc_d5>="0" && oc_d5<="9" ) && ( oc_d6>="0" && oc_d6<="9" )
			    && ( oc_d7>="0" && oc_d7<="9" ) && ( oc_d8>="0" && oc_d8<="9" )
			VAR res_oc =
			    IF( oc_valido, "OC-" & oc_d1&oc_d2&oc_d3&oc_d4&oc_d5&oc_d6&oc_d7&oc_d8, BLANK() )
			
			-- PATRON 2: 'PO ' seguido de 5 o 6 digitos
			VAR pos_po = IF( res_oc = BLANK(), SEARCH( "PO ", txt_up, 1, 0 ), 0 )
			VAR p1 = IF( pos_po > 0, MID( txt_up, pos_po+3, 1 ), "X" )
			VAR p2 = IF( pos_po > 0, MID( txt_up, pos_po+4, 1 ), "X" )
			VAR p3 = IF( pos_po > 0, MID( txt_up, pos_po+5, 1 ), "X" )
			VAR p4 = IF( pos_po > 0, MID( txt_up, pos_po+6, 1 ), "X" )
			VAR p5 = IF( pos_po > 0, MID( txt_up, pos_po+7, 1 ), "X" )
			VAR p6 = IF( pos_po > 0, MID( txt_up, pos_po+8, 1 ), "X" )
			VAR p7 = IF( pos_po > 0, MID( txt_up, pos_po+9, 1 ), "X" )
			VAR po_6dig =
			    pos_po > 0
			    && ( p1>="0" && p1<="9" ) && ( p2>="0" && p2<="9" )
			    && ( p3>="0" && p3<="9" ) && ( p4>="0" && p4<="9" )
			    && ( p5>="0" && p5<="9" ) && ( p6>="0" && p6<="9" )
			    && NOT ( p7>="0" && p7<="9" )
			VAR po_5dig =
			    pos_po > 0 && NOT po_6dig
			    && ( p1>="0" && p1<="9" ) && ( p2>="0" && p2<="9" )
			    && ( p3>="0" && p3<="9" ) && ( p4>="0" && p4<="9" )
			    && ( p5>="0" && p5<="9" )
			    && NOT ( p6>="0" && p6<="9" )
			VAR res_po =
			    IF( po_6dig, "OC-00" & p1&p2&p3&p4&p5&p6,
			        IF( po_5dig, "OC-000" & p1&p2&p3&p4&p5, BLANK() ) )
			
			-- PATRON 3: 'OC ' (sin guion) seguido de 5, 6 u 8 digitos
			VAR pos_ocs = IF( res_oc = BLANK() && res_po = BLANK(), SEARCH( "OC ", txt_up, 1, 0 ), 0 )
			VAR s1 = IF( pos_ocs > 0, MID( txt_up, pos_ocs+3, 1 ), "X" )
			VAR s2 = IF( pos_ocs > 0, MID( txt_up, pos_ocs+4, 1 ), "X" )
			VAR s3 = IF( pos_ocs > 0, MID( txt_up, pos_ocs+5, 1 ), "X" )
			VAR s4 = IF( pos_ocs > 0, MID( txt_up, pos_ocs+6, 1 ), "X" )
			VAR s5 = IF( pos_ocs > 0, MID( txt_up, pos_ocs+7, 1 ), "X" )
			VAR s6 = IF( pos_ocs > 0, MID( txt_up, pos_ocs+8, 1 ), "X" )
			VAR s7 = IF( pos_ocs > 0, MID( txt_up, pos_ocs+9, 1 ), "X" )
			VAR s8 = IF( pos_ocs > 0, MID( txt_up, pos_ocs+10, 1 ), "X" )
			-- 8 digitos: OC 00XXXXXX
			VAR ocs_8dig =
			    pos_ocs > 0
			    && ( s1>="0" && s1<="9" ) && ( s2>="0" && s2<="9" )
			    && ( s3>="0" && s3<="9" ) && ( s4>="0" && s4<="9" )
			    && ( s5>="0" && s5<="9" ) && ( s6>="0" && s6<="9" )
			    && ( s7>="0" && s7<="9" ) && ( s8>="0" && s8<="9" )
			-- 6 digitos: OC XXXXXX
			VAR ocs_6dig =
			    pos_ocs > 0 && NOT ocs_8dig
			    && ( s1>="0" && s1<="9" ) && ( s2>="0" && s2<="9" )
			    && ( s3>="0" && s3<="9" ) && ( s4>="0" && s4<="9" )
			    && ( s5>="0" && s5<="9" ) && ( s6>="0" && s6<="9" )
			    && NOT ( s7>="0" && s7<="9" )
			-- 5 digitos: OC XXXXX
			VAR ocs_5dig =
			    pos_ocs > 0 && NOT ocs_8dig && NOT ocs_6dig
			    && ( s1>="0" && s1<="9" ) && ( s2>="0" && s2<="9" )
			    && ( s3>="0" && s3<="9" ) && ( s4>="0" && s4<="9" )
			    && ( s5>="0" && s5<="9" )
			    && NOT ( s6>="0" && s6<="9" )
			VAR res_ocs =
			    IF( ocs_8dig, "OC-" & s1&s2&s3&s4&s5&s6&s7&s8,
			        IF( ocs_6dig, "OC-00" & s1&s2&s3&s4&s5&s6,
			            IF( ocs_5dig, "OC-000" & s1&s2&s3&s4&s5, BLANK() ) ) )
			
			RETURN COALESCE( res_oc, res_po, res_ocs )
		dataType: string
		displayFolder: Saldos
		lineageTag: 402f7830-160d-4234-8cfc-425c41d28cf1
		summarizeBy: none

	partition VENDTRANS = m
		mode: import
		source =
				let
				    Origen = Sql.Database("SJODB003", "GIAX2012_PROD", [Query="select dataareaid as empresa, accountnum as proveedor, amountcur, settleamountcur, txt , recid from vendtrans#(lf)where dataareaid = 'cmer' and partition = 5637144576 and createddatetime >= dateadd(yy,-1,getdate())#(lf)"])
				in
				    Origen

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación

