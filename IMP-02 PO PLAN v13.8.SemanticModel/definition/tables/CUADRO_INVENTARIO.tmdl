	partition CUADRO_INVENTARIO = m
		mode: import
		source =
				let
				    Origen = Sql.Database("SJODB003", "GIAX2012_PROD", [Query="SELECT IT.ITEMID, #(lf)IT.DATAAREAID,#(lf)IT.DATAAREAID + IT.ITEMID AS KEY_1,#(lf)IT.GI_InventoryBoxNumber AS CUADRO,#(lf)ITB.GI_INVENTORYBOXNAME AS NOMBRE_CUADRO,#(lf)ITB.PERIODICITY as Periodicidad,#(lf)ITB.INCHARGE as Encargado,#(lf)PROD.NAME AS NOMBRE_PRODCUTO,#(lf)LCP.NAME AS NOMBRE_CICLO,#(lf)CASE LIFECYCLE#(lf)WHEN 1 THEN 'Activo'#(lf)WHEN 2 THEN 'Inactivo'#(lf)ELSE ''#(lf)END AS CICLO_CUADRO,#(lf)CASE ORIGINVENDOR#(lf)WHEN 1 THEN 'Internacional'#(lf)WHEN 2 THEN 'Nacional'#(lf)WHEN 3 THEN 'Ensamble'#(lf)ELSE ''#(lf)END AS ORIGEN_PROVEEDOR#(lf)FROM INVENTTABLE IT LEFT OUTER JOIN #(lf)INVENTORYBOX ITB ON ITB.GI_INVENTORYBOXNUMBER = IT.GI_InventoryBoxNumber AND ITB.DATAAREAID = IT.DATAAREAID LEFT OUTER JOIN#(lf)PRODUCTSPBI PROD ON PROD.ITEMID = IT.ITEMID LEFT OUTER JOIN #(lf)LifeCycleProducts LCP ON LCP.LIFECYCLEID = IT.LIFECYCLEPRODUCTID AND LCP.DATAAREAID = IT.DATAAREAID#(lf)WHERE IT.GI_InventoryBoxNumber <> ''", MultiSubnetFailover=true]),
				    #"Duplicados quitados" = Table.Distinct(Origen, {"KEY_1"})
				in
				    #"Duplicados quitados"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación

