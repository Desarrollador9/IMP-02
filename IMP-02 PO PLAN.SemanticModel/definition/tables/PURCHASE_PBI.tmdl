			    _semsLlegada = 14, "2.T+14",
			    _semsLlegada = 15, "2.T+15",
			    _semsLlegada = 16, "2.T+16",
			    _semsLlegada = 17, "2.T+17",
			    _semsLlegada = 18, "2.T+18",
			    _semsLlegada = 19, "2.T+19",
			    _semsLlegada = 20, "3.T+20",
			    _semsLlegada = 21, "3.T+21",
			    _semsLlegada = 22, "3.T+22",
			    _semsLlegada = 23, "3.T+23",
			    _semsLlegada = 24, "3.T+24",
			    _semsLlegada = 25, "3.T+25",
			    _semsLlegada = 26, "3.T+26",
			    _semsLlegada = 27, "3.T+27",
			    _semsLlegada = 28, "3.T+28",
			    _semsLlegada = 29, "3.T+29",
			    _semsLlegada = 30, "4.T+30",
			    "5.Otras Sem"
			)
		lineageTag: 9a881fef-0a08-46b4-9714-b144fd692d7c
