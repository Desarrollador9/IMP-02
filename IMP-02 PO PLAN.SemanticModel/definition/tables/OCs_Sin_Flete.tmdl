table OCs_Sin_Flete
	lineageTag: 94598f8f-8f94-419e-98f6-9933219bba74

	column PURCHID
		lineageTag: a0ce2f4b-5af3-4f0e-b3b3-4749be70bb24
		summarizeBy: none
		isNameInferred
		sourceColumn: PURCHASE_PBI[PURCHID]

		annotation SummarizationSetBy = Automatic

	partition OCs_Sin_Flete = calculated
		mode: import
		source = ```
				
				VAR TodasOCs = DISTINCT(PURCHASE_PBI[PURCHID])
				VAR OCsConFlete = 
				    UNION(
				        DISTINCT(SELECTCOLUMNS('Consulta1', "OC", 'Consulta1'[PO_MADRE])),
				        DISTINCT(SELECTCOLUMNS('Consulta1', "OC", 'Consulta1'[PO_HIJA]))
				    )
				RETURN
				EXCEPT(TodasOCs, OCsConFlete)
				```

	annotation PBI_Id = 5c925cc93a664b1ca622efcbf0d030ba

