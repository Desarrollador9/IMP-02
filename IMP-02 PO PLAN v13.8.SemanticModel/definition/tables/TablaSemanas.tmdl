	partition TablaSemanas = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				    GENERATESERIES(0, 25, 1), -- Genera las semanas de T+1 a T+26 (6 meses)
				    "Semanas", "1.T+" & [Value] + 1,
				    "FechaInicio", TODAY() - WEEKDAY(TODAY(), 2) + ([Value] * 7), -- Calcula el lunes de cada semana
				    "FechaFin", TODAY() - WEEKDAY(TODAY(), 2) + ([Value] * 7) + 6, -- Calcula el domingo correspondiente
				    "RangoFechas", -- Agrega el rango de fechas
				        FORMAT(TODAY() - WEEKDAY(TODAY(), 2) + ([Value] * 7), "dd/MM/yyyy") & " - " &
				        FORMAT(TODAY() - WEEKDAY(TODAY(), 2) + ([Value] * 7) + 6, "dd/MM/yyyy")
				)
				
				```

	annotation PBI_Id = 0185d68129c94a1a80fe4f23a6f9b8da

