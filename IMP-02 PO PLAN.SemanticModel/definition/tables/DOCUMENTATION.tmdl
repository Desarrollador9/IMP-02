				    Origen = Sql.Database("SJODB003", "GIAX2012_PROD", [Query="SELECT T1.DATAAREAID,T1.PURCHID,T1.LlegadaEstDocsOrigs AS LLEGADA_DOC_ORIG,#(lf)T1.SIT_DateOrigDocs AS DOC_ORIG_INT, #(lf)T1.SIT_WeekOrigDocs AS SEM_DOC_ORIG,#(lf)T1.SIT_SendDateCopies AS ENVIO_COPIAS,#(lf)T1.OkCopiasDocumentos AS OK_COPIAS_DOC,#(lf)T1.DateBLOrigen AS FECHA_BL,#(lf)T1.DateBorradorBL AS BORRADOR_BL,#(lf)T1.SIT_ShippingAWBDate AS ENVIO_BL,#(lf)T1.DateAprobBorradorBL AS APROB_BL,#(lf)T1.DateBorradorCOO AS BORRADOR_COO,#(lf)T1.DateAprobBorradorCOO AS APROB_BORRADOR_COO,#(lf)T1.OkCertificadoOrigen AS APROB_CERTIF_ORIGEN,#(lf)T1.DateBorrCertFitoOrig AS BORR_CERTIF_FITO_ORIGEN,#(lf)T1.DateAprobBorrCertFitoOrig AS APROB_BORR_CERTIF_FITO_ORIGEN,#(lf)T1.DateCertFitoDest AS CERTIF_FITO_DEST,#(lf)T1.DateAprobCertFitoDest AS APROB_CERTIF_FITO_DEST,#(lf)T1.DateCertZoosOrig AS CERTIF_ZOOS_ORIGEN,#(lf)T1.DateAprobZoosOrig AS APROB_ZOOS_ORIGEN,#(lf)T1.SIT_SendDateAgencyDocs AS ENVIO_COPIAS_AGENCIA,#(lf)T1.SIT_DateOrigDocAgen AS ENVIO_ORIG_AGENCIA,#(lf)T1.SIT_WeekOrigDocAgen AS SEM_DOC_ORIG_AGEN,#(lf)T1.AceptacionDocsAgencia AS ACEP_DOC_AGENCIA,#(lf)T1.AgenciaFirmaPrinter AS AGENC_FIRMA_PRINTER,#(lf)T1.ExoneracionHacienda AS EXON_HACIENDA,#(lf)T1.PlantNumber AS PLANTA#(lf)FROM PURCHTABLE T1#(lf)WHERE T1.DATAAREAID = 'CMER' AND T1.CREATEDDATETIME >= DATEADD(MM,-12,GETDATE())", MultiSubnetFailover=true])
				in
				    Origen

	annotation PBI_ResultType = Table

