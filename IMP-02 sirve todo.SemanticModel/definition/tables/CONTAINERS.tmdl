table CONTAINERS
	lineageTag: d27fe66c-8104-409e-9417-05a76c8fb883

	measure 'Cant Contenedores' =
			
			COUNTROWS(
			    FILTER(
			        VALUES(CONTAINERS[CONTENEDOR]),
			        CONTAINERS[CONTENEDOR] <> BLANK()
			    )
			)
		formatString: 0
		lineageTag: d5e33cdd-fbf6-4c96-8e16-c1d118f4fbbd

	measure Total_Entradas_Tarima =
			
			SUMX(
			    VALUES(CONTAINERS[CONTENEDOR]),
			    [Entradas_Tarima_Completa]
			)
		lineageTag: f56ad9ae-0a72-4890-a103-eabb9fc25eba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

