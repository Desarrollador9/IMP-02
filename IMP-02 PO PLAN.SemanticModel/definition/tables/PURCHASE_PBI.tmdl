	column 'Error 1' = IF(PURCHASE_PBI[ESTADO] = "PROPUESTA" && PURCHASE_PBI[SALIDA_AJUSTADA] < TODAY(),"Error", "No Error")
		lineageTag: 88d8e008-27d6-4eff-b376-4d466e0124e3
