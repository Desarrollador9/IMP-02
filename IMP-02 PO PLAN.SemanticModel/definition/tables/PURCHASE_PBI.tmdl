	measure Semana_Bodega = ```
			
			VAR FechaMinimaVisible = CALCULATE(MIN(PURCHASE_PBI[SALIDA_AJUSTADA]), ALLSELECTED(PURCHASE_PBI)) 
			VAR LunesMinimo = FechaMinimaVisible - WEEKDAY(FechaMinimaVisible, 2) + 1 -- Ajusta la fecha mínima al lunes más cercano
			VAR FechaActual = SELECTEDVALUE(PURCHASE_PBI[SALIDA_AJUSTADA]) -- Selecciona la fecha de la fila actual
			VAR DiasDesdeLunesMinimo = DATEDIFF(LunesMinimo, FechaActual, DAY) 
			RETURN
			    IF(
			        FechaActual = BLANK() || FechaActual = DATE(1900,1,1),
			        "Sin Fecha",
			        "T+" & INT(DiasDesdeLunesMinimo / 7) + 1
			    )
			
			```
		lineageTag: ef8c1d85-3c08-499c-a706-908a7e4771d2

	measure Rango_Semana_Bodega = ```
			
			VAR FechaMinimaVisible = CALCULATE(MIN(PURCHASE_PBI[SALIDA_AJUSTADA]), ALLSELECTED(PURCHASE_PBI)) 
			VAR LunesMinimo = FechaMinimaVisible - WEEKDAY(FechaMinimaVisible, 2) + 1 -- Ajusta la fecha mínima al lunes más cercano
			VAR FechaActual = SELECTEDVALUE(PURCHASE_PBI[SALIDA_AJUSTADA]) -- Fecha de la fila actual
			VAR DiasDesdeLunesMinimo = DATEDIFF(LunesMinimo, FechaActual, DAY) 
			VAR SemanaInicio = LunesMinimo + INT(DiasDesdeLunesMinimo / 7) * 7 -- Lunes de la semana actual
			VAR SemanaFin = SemanaInicio + 6 -- Domingo de la misma semana
			RETURN
			    IF(
			        FechaActual = BLANK() || FechaActual = DATE(1900,1,1),
			        "Sin Fecha",
			        FORMAT(SemanaInicio, "dd/MM/yyyy") & " - " & FORMAT(SemanaFin, "dd/MM/yyyy")
			    )
			
			```
		lineageTag: f17ad5b3-d35b-4d7a-b27b-4c7b5628717d

